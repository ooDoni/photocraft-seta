+// ------------------------------------------------------------------ the options bar
+
+const HEADS: [(u8, &str); 4] = [(geo::HEAD_TRIANGLE, "Triângulo"), (geo::HEAD_BARBED, "Farpa"), (geo::HEAD_OPEN, "Aberta (V)"), (geo::HEAD_NONE, "Nenhuma")];
+const TAILS: [(u8, &str); 3] = [(geo::TAIL_FLAT, "Reto"), (geo::TAIL_POINTED, "Pontudo"), (geo::TAIL_ARROW, "Duas pontas")];
+const LINES: [(u8, &str); 3] = [(0, "Sólida"), (1, "Tracejada"), (2, "Pontilhada")];
+const SECTIONS: [(u8, &str); 4] = [(0, "Ponta"), (1, "Início"), (2, "Linha"), (3, "Opacidade")];
+
+/// The line style a dash setting shows as: 0 solid, 1 dashed, 2 dotted.
+fn line_kind(o: &ArrowOptions) -> u8 {
+    if o.dash <= 0.0 {
+        0
+    } else if (o.dash - 1.0).abs() < 0.01 && o.dash_round >= 99.0 {
+        2
+    } else {
+        1
+    }
+}
+
+/// The colour an uncoloured point shows: the arrow's fill colour (black without one).
+fn point_base_color(app: &PhotocraftApp, a: &Arrow) -> [f32; 3] {
+    let fill = app.session.active().and_then(|st| st.doc.layer(a.id)).and_then(|l| match &l.content {
+        LayerContent::Shape(sh) => sh.fill.clone(),
+        _ => None,
+    });
+    match fill {
+        Some(photocraft_doc::Fill::Solid(c)) => c.to_rgb(),
+        Some(photocraft_doc::Fill::Gradient { stops, .. }) => stops.first().map_or([0.0; 3], |s| s.1.to_rgb()),
+        _ => [0.0; 3],
+    }
+}
+
+
+/// A captioned number field of the bar; true when its value changed.
+fn field(ui: &mut egui::Ui, caption: &str, value: &mut f32, range: std::ops::RangeInclusive<f32>, unit: &str, whole: bool, tip: &str) -> bool {
+    let was = *value;
+    opt_label(ui, caption);
+    let r = if whole { widgets::value_field_whole(ui, value, range, unit, 52.0) } else { widgets::value_field(ui, value, range, unit, 56.0) };
+    r.on_hover_text(tip);
+    (*value - was).abs() > f32::EPSILON
+}
+
+/// The Curved Arrow tool's options bar; false for another tool. The widths always show; a
+/// switch picks the head, the start, the line or the opacity settings.
+pub fn options_bar(app: &mut PhotocraftApp, ui: &mut egui::Ui, tool: Tool) -> bool {
+    if tool != Tool::CurveArrow {
+        return false;
+    }
+    forget_stale(app);
+    let arrow = active_arrow(app);
+    let mut o = options();
+    // An arrow's own values show while it is selected.
+    if let Some(a) = &arrow {
+        o.start_width = a.widths.first().copied().unwrap_or(20.0) as f32;
+        o.end_width = a.widths.last().copied().unwrap_or(40.0) as f32;
+        o.head = a.head;
+        o.head_length = a.head_length as f32;
+        o.head_width = a.head_width as f32;
+        o.tip_round = a.tip_round as f32;
+        o.barb_round = a.barb_round as f32;
+        o.tail = a.tail;
+        o.tail_round = a.tail_round as f32;
+        o.dash = a.dash as f32;
+        o.gap = a.gap as f32;
+        o.dash_round = a.dash_round as f32;
+        o.fade_start = a.fade_start as f32;
+        o.fade_end = a.fade_end as f32;
+    }
+    let before = o;
+    let sel = selected().filter(|(id, _)| arrow.as_ref().is_some_and(|a| a.id == *id));
+
+    // widths, the selected point, its colour and curve
+    field(ui, "Início", &mut o.start_width, 0.5..=2000.0, "px", false, "Espessura no início da seta");
+    field(ui, "Fim", &mut o.end_width, 0.5..=2000.0, "px", false, "Espessura perto da ponta");
+    let mut point_width = None;
+    let mut clear_color = None;
+    let mut auto_curve = None;
+    if let (Some(a), Some((_, i))) = (&arrow, sel)
+        && let Some(w) = a.widths.get(i)
+    {
+        let mut v = *w as f32;
+        if field(ui, &format!("Ponto {}", i + 1), &mut v, 0.5..=2000.0, "px", false, "Espessura do ponto selecionado") {
+            point_width = Some((i, f64::from(v)));
+        }
+        let own = a.colors.get(i).copied().flatten();
+        let rgb = own.map_or_else(|| point_base_color(app, a), |c| c.to_rgb());
+        let shown = Color32::from_rgb((rgb[0].clamp(0.0, 1.0) * 255.0) as u8, (rgb[1].clamp(0.0, 1.0) * 255.0) as u8, (rgb[2].clamp(0.0, 1.0) * 255.0) as u8);
+        if widgets::color_swatch_button(ui, shown, "Cor do ponto (o degradê segue a curva)").clicked() {
+            crate::color_picker_ui::open_for_command(app, "Cor do ponto", rgb, "shape.edit", json!({"layer": a.id.0, "pointColor": i}));
+        }
+        if own.is_some() && widgets::secondary_button(ui, "×", 0.0).on_hover_text("Tira a cor deste ponto (volta a misturar com os vizinhos)").clicked() {
+            clear_color = Some(i);
+        }
+        if a.custom(i) && widgets::secondary_button(ui, "Curva auto", 0.0).on_hover_text("Volta a curva deste ponto para a automática").clicked() {
+            auto_curve = Some(i);
+        }
+    }
+    let flip = ui.add_enabled_ui(arrow.is_some(), |ui| widgets::secondary_button(ui, "Inverter", 0.0).on_hover_text("Troca a ponta com o início").clicked()).inner;
+    widgets::vline(ui, 22.0);
+
+    // which settings
+    let mut section = shared(|s| s.section);
+    for (v, label) in SECTIONS {
+        if ui.selectable_label(section == v, label).clicked() {
+            section = v;
+        }
+    }
+    shared(|s| s.section = section);
+    widgets::vline(ui, 22.0);
+    match section {
+        1 => {
+            opt_label(ui, "Formato");
+            widgets::dropdown(ui, "curve-arrow-tail", "Formato do início", &mut o.tail, &TAILS, 110.0);
+            field(ui, "Arred.", &mut o.tail_round, 0.0..=100.0, "%", true, "Arredondar o início (0 = quadrado, 100 = redondo)");
+        }
+        2 => {
+            let mut kind = line_kind(&o);
+            opt_label(ui, "Linha");
+            if widgets::dropdown(ui, "curve-arrow-line", "Linha", &mut kind, &LINES, 110.0) {
+                match kind {
+                    0 => o.dash = 0.0,
+                    2 => (o.dash, o.gap, o.dash_round) = (1.0, 1.0, 100.0),
+                    _ => (o.dash, o.gap, o.dash_round) = (2.0, 1.0, 0.0),
+                }
+            }
+            if o.dash > 0.0 {
+                field(ui, "Traço", &mut o.dash, 0.1..=50.0, "×", false, "Comprimento de cada traço, em espessuras da linha");
+                field(ui, "Espaço", &mut o.gap, 0.0..=50.0, "×", false, "Espaço entre os traços, em espessuras da linha");
+                field(ui, "Arred.", &mut o.dash_round, 0.0..=100.0, "%", true, "Arredondar as pontas dos traços (100 com traço 1× = bolinhas)");
+            }
+        }
+        3 => {
+            field(ui, "Opac. início", &mut o.fade_start, 0.0..=100.0, "%", true, "Opacidade no começo da seta (o degradê segue a curva)");
+            field(ui, "Opac. ponta", &mut o.fade_end, 0.0..=100.0, "%", true, "Opacidade na ponta da seta");
+        }
+        _ => {
+            opt_label(ui, "Formato");
+            widgets::dropdown(ui, "curve-arrow-head", "Formato da ponta", &mut o.head, &HEADS, 110.0);
+            field(ui, "Compr.", &mut o.head_length, 1.0..=4000.0, "px", false, "Comprimento da ponta");
+            field(ui, "Larg.", &mut o.head_width, 1.0..=4000.0, "px", false, "Largura da ponta");
+            field(ui, "Bico", &mut o.tip_round, 0.0..=100.0, "%", true, "Arredondar o bico da ponta");
+            field(ui, "Abas", &mut o.barb_round, 0.0..=100.0, "%", true, "Arredondar as abas da ponta");
+        }
+    }
+
+    // what changed
+    set_options(o);
+    let Some(a) = arrow else {
+        widgets::vline(ui, 22.0);
+        ui.label(egui::RichText::new("Clique os pontos na imagem · Enter termina").weak());
+        return true;
+    };
+    let mut patch = serde_json::Map::new();
+    if (o.start_width - before.start_width).abs() > f32::EPSILON || (o.end_width - before.end_width).abs() > f32::EPSILON {
+        patch.insert("widths".into(), json!(tapered(&a.points, &a.handles, f64::from(o.start_width), f64::from(o.end_width))));
+    }
+    if let Some((i, w)) = point_width {
+        let mut widths = a.widths.clone();
+        if let Some(slot) = widths.get_mut(i) {
+            *slot = w;
+        }
+        patch.insert("widths".into(), json!(widths));
+    }
+    let mut set = |key: &str, now: f32, was: f32| {
+        if (now - was).abs() > f32::EPSILON {
+            patch.insert(key.into(), json!(now));
+        }
+    };
+    set("headLength", o.head_length, before.head_length);
+    set("headWidth", o.head_width, before.head_width);
+    set("tipRound", o.tip_round, before.tip_round);
+    set("barbRound", o.barb_round, before.barb_round);
+    set("tailRound", o.tail_round, before.tail_round);
+    set("dash", o.dash, before.dash);
+    set("gap", o.gap, before.gap);
+    set("dashRound", o.dash_round, before.dash_round);
+    set("fadeStart", o.fade_start, before.fade_start);
+    set("fadeEnd", o.fade_end, before.fade_end);
+    if o.head != before.head {
+        patch.insert("head".into(), json!(o.head));
+    }
+    if o.tail != before.tail {
+        patch.insert("tail".into(), json!(o.tail));
+    }
+    if let Some(i) = clear_color {
+        patch.insert("pointColor".into(), json!(i));
+        patch.insert("color".into(), Value::Null);
+    }
+    if let Some(i) = auto_curve {
+        let mut handles = a.handle_list();
+        if let Some(slot) = handles.get_mut(i) {
+            *slot = None;
+        }
+        patch.insert("handles".into(), json!(handles));
+    }
+    if flip {
+        let points: Vec<[f64; 2]> = a.points.iter().rev().copied().collect();
+        // The widths stay in arrow order, so the start stays thin and the head end thick.
+        patch.insert("points".into(), json!(points));
+        // each point's handles swap sides, and each point keeps its colour
+        let handles: Vec<Option<[f64; 4]>> = a.handle_list().iter().rev().map(|h| h.map(|h| [h[2], h[3], h[0], h[1]])).collect();
+        patch.insert("handles".into(), json!(handles));
+        let colors: Vec<Value> = a.color_list().into_iter().rev().collect();
+        patch.insert("colors".into(), json!(colors));
+        select(None);
+    }
+    if !patch.is_empty() {
+        let key = if flip || auto_curve.is_some() || clear_color.is_some() { None } else { Some(format!("curveArrow.bar.{}", a.id.0)) };
+        edit(app, a.id, Value::Object(patch), key.as_deref());
+    }
+    true
+}
