diff --git a/crates/engine/src/cmd/vector_cmds/curve_arrow_tests.rs b/crates/engine/src/cmd/vector_cmds/curve_arrow_tests.rs
new file mode 100644
index 0000000..6e57d22
--- /dev/null
+++ b/crates/engine/src/cmd/vector_cmds/curve_arrow_tests.rs
@@ -0,0 +1,169 @@
+//! The Curved Arrow tool's live shape: created, edited, moved, scaled, undone.
+
+use serde_json::{Value, json};
+
+use photocraft_doc::vector::LiveShape;
+use photocraft_doc::{LayerContent, LayerId};
+use crate::Session;
+
+fn session() -> Session {
+    let mut s = Session::new();
+    s.execute("file.new", json!({"width": 400, "height": 300, "background": "white"})).unwrap();
+    s
+}
+
+fn live(s: &Session, id: u64) -> Option<LiveShape> {
+    let l = s.active().unwrap().doc.layer(LayerId(id)).unwrap();
+    match &l.content {
+        LayerContent::Shape(sh) => sh.live.clone(),
+        _ => None,
+    }
+}
+
+fn coverage(s: &Session, id: u64) -> f64 {
+    let l = s.active().unwrap().doc.layer(LayerId(id)).unwrap();
+    let LayerContent::Shape(sh) = &l.content else { panic!("a shape") };
+    let c = sh.cache.as_ref().unwrap();
+    let r = c.content_bounds();
+    let fmt = c.format();
+    c.read_region(r).chunks_exact(fmt.channels()).map(|p| f64::from(photocraft_raster::to_rgba(&fmt, p)[3])).sum()
+}
+
+fn create(s: &mut Session) -> Value {
+    s.execute(
+        "shape.create",
+        json!({"kind": "curveArrow", "points": [[40, 250], [150, 40], [330, 160]], "widths": [10, 24], "head": 0, "headLength": 50, "headWidth": 70, "tailRound": 100}),
+    )
+    .unwrap()
+}
+
+#[test]
+fn create_makes_a_live_arrow_named_seta() {
+    let mut s = session();
+    let r = create(&mut s);
+    let id = r["layer"].as_u64().unwrap();
+    assert_eq!(r["kind"], "curveArrow");
+    assert!(r["name"].as_str().unwrap().starts_with("Seta"), "{r}");
+    let Some(LiveShape::CurveArrow { points, widths, .. }) = live(&s, id) else { panic!("live arrow") };
+    assert_eq!(points.len(), 3);
+    assert_eq!(widths.len(), 3, "widths stretched to one per point");
+    assert!((widths[1] - 17.0).abs() < 1e-9);
+    assert!(coverage(&s, id) > 3000.0);
+}
+
+#[test]
+fn edits_regenerate_and_undo() {
+    let mut s = session();
+    let id = create(&mut s)["layer"].as_u64().unwrap();
+    let before = coverage(&s, id);
+    s.execute("shape.edit", json!({"layer": id, "headWidth": 140, "tipRound": 60})).unwrap();
+    assert!(coverage(&s, id) > before);
+    // a drag's moves share one step
+    for k in 0..5 {
+        s.execute("shape.edit", json!({"layer": id, "points": [[40, 250], [150 + k * 5, 40], [330, 160]], "coalesce": "drag"})).unwrap();
+    }
+    let Some(LiveShape::CurveArrow { points, head_width, .. }) = live(&s, id) else { panic!() };
+    assert_eq!(points[1], [170.0, 40.0]);
+    assert_eq!(head_width, 140.0);
+    assert!(s.undo());
+    let Some(LiveShape::CurveArrow { points, .. }) = live(&s, id) else { panic!() };
+    assert_eq!(points[1], [150.0, 40.0], "one undo takes the whole drag back");
+}
+
+#[test]
+fn bad_params_are_refused() {
+    let mut s = session();
+    assert!(s.execute("shape.create", json!({"kind": "curveArrow", "points": [[1, 1]]})).is_err());
+    assert!(s.execute("shape.create", json!({"kind": "curveArrow", "points": [[1, 1], [50, 50]], "widths": [-3, 4]})).is_err());
+    assert!(s.execute("shape.create", json!({"kind": "curveArrow", "points": [[1, 1], [50, 50]], "head": 9})).is_err());
+}
+
+#[test]
+fn moving_and_scaling_keep_it_editable() {
+    let mut s = session();
+    let id = create(&mut s)["layer"].as_u64().unwrap();
+    s.execute("shape.edit", json!({"layer": id, "move": [10, -5]})).unwrap();
+    let Some(LiveShape::CurveArrow { points, .. }) = live(&s, id) else { panic!("still live after a move") };
+    assert_eq!(points[0], [50.0, 245.0]);
+    s.execute("shape.edit", json!({"layer": id, "transform": [2, 0, 0, 2, 0, 0]})).unwrap();
+    let Some(LiveShape::CurveArrow { widths, head_length, .. }) = live(&s, id) else { panic!("still live after a uniform scale") };
+    assert_eq!(widths[0], 20.0);
+    assert_eq!(head_length, 100.0);
+    s.execute("shape.edit", json!({"layer": id, "transform": [1, 0, 0, 3, 0, 0]})).unwrap();
+    assert!(live(&s, id).is_none(), "a non-uniform scale leaves the exact outline as a path");
+}
+
+fn fill(s: &Session, id: u64) -> Option<photocraft_doc::Fill> {
+    let l = s.active().unwrap().doc.layer(LayerId(id)).unwrap();
+    let LayerContent::Shape(sh) = &l.content else { panic!("a shape") };
+    sh.fill.clone()
+}
+
+#[test]
+fn handles_bend_the_curve_and_follow_their_points() {
+    let mut s = session();
+    let id = create(&mut s)["layer"].as_u64().unwrap();
+    let before = coverage(&s, id);
+    s.execute("shape.edit", json!({"layer": id, "handles": [null, [-80, -40, 80, 40], null]})).unwrap();
+    let Some(LiveShape::CurveArrow { handles, .. }) = live(&s, id) else { panic!() };
+    assert_eq!(handles, vec![None, Some([-80.0, -40.0, 80.0, 40.0]), None]);
+    assert!((coverage(&s, id) - before).abs() > 1.0, "the curve changed");
+    // bad handles are refused
+    assert!(s.execute("shape.edit", json!({"layer": id, "handles": [[1, 2, 3]]})).is_err());
+    // a rotation turns the offsets with the points
+    s.execute("shape.edit", json!({"layer": id, "transform": [0, 1, -1, 0, 300, 0]})).unwrap();
+    let Some(LiveShape::CurveArrow { handles, .. }) = live(&s, id) else { panic!("still live after a rotation") };
+    let h = handles[1].unwrap();
+    assert!((h[0] - 40.0).abs() < 1e-9 && (h[1] + 80.0).abs() < 1e-9, "{h:?}");
+    // all automatic again: stored as none
+    s.execute("shape.edit", json!({"layer": id, "handles": [null, null, null]})).unwrap();
+    let Some(LiveShape::CurveArrow { handles, .. }) = live(&s, id) else { panic!() };
+    assert!(handles.is_empty());
+}
+
+/// Alpha at the start and at the tip of the default arrow's cache (near its first and last point).
+fn alpha_near(s: &Session, id: u64, at: [i32; 2]) -> f32 {
+    let l = s.active().unwrap().doc.layer(LayerId(id)).unwrap();
+    let LayerContent::Shape(sh) = &l.content else { panic!("a shape") };
+    let c = sh.cache.as_ref().unwrap();
+    let fmt = c.format();
+    let r = photocraft_geom::Rect::new(at[0] - 3, at[1] - 3, at[0] + 4, at[1] + 4);
+    c.read_region(r).chunks_exact(fmt.channels()).map(|p| photocraft_raster::to_rgba(&fmt, p)[3]).fold(0.0, f32::max)
+}
+
+#[test]
+fn a_fade_and_point_colours_follow_the_curve() {
+    use photocraft_doc::Fill;
+    let mut s = session();
+    // a U: start and tip close in a straight line, far apart along the curve
+    let id = s
+        .execute("shape.create", json!({"kind": "curveArrow", "points": [[60, 250], [200, 40], [340, 250]], "widths": [30, 30], "head": 3, "tailRound": 0, "fill": "#0000ff"}))
+        .unwrap()["layer"]
+        .as_u64()
+        .unwrap();
+    let solid = coverage(&s, id);
+    s.execute("shape.edit", json!({"layer": id, "fadeStart": 0})).unwrap();
+    assert!(matches!(fill(&s, id), Some(Fill::Solid(_))), "the fill stays the base colour");
+    let faded = coverage(&s, id);
+    assert!(faded < solid * 0.7 && faded > solid * 0.3, "{faded} of {solid}");
+    assert!(alpha_near(&s, id, [62, 245]) < 0.15, "transparent at the start");
+    assert!(alpha_near(&s, id, [338, 245]) > 0.85, "opaque at the tip");
+    // the colour picker's answer for one point; uncoloured ends keep the fill's colour
+    s.execute("shape.edit", json!({"layer": id, "fadeStart": 100, "pointColor": 2, "color": "#ff0000"})).unwrap();
+    let Some(LiveShape::CurveArrow { colors, .. }) = live(&s, id) else { panic!() };
+    assert_eq!(colors.len(), 3);
+    assert!(colors[0].is_none() && colors[2].is_some());
+    assert!(s.execute("shape.edit", json!({"layer": id, "pointColor": 9, "color": "#ff0000"})).is_err());
+    let l = s.active().unwrap().doc.layer(LayerId(id)).unwrap();
+    let LayerContent::Shape(sh) = &l.content else { panic!() };
+    let c = sh.cache.as_ref().unwrap();
+    let fmt = c.format();
+    let px = |x: i32, y: i32| photocraft_raster::to_rgba(&fmt, &c.read_region(photocraft_geom::Rect::new(x, y, x + 1, y + 1)));
+    let (start, tip) = (px(64, 240), px(336, 240));
+    assert!(start[2] > start[0], "blue at the start: {start:?}");
+    assert!(tip[0] > tip[2], "red at the tip: {tip:?}");
+    // no colour on any point: plain again
+    s.execute("shape.edit", json!({"layer": id, "pointColor": 2, "color": null})).unwrap();
+    let Some(LiveShape::CurveArrow { colors, .. }) = live(&s, id) else { panic!() };
+    assert!(colors.is_empty());
+}
diff --git a/crates/engine/src/cmd/vector_cmds/params.rs b/crates/engine/src/cmd/vector_cmds/params.rs
index bab083c..b99df19 100644
--- a/crates/engine/src/cmd/vector_cmds/params.rs
+++ b/crates/engine/src/cmd/vector_cmds/params.rs
@@ -404,6 +404,192 @@ pub(super) fn live_from_params(cmd: &str, kind: &str, p: &Value, prev: Option<&L
                 LiveShape::Line { from, to, weight }
             }
         }
+        "curveArrow" | "arrowCurve" => curve_arrow_from_params(cmd, p, prev)?,
         o => return Err(bad(cmd, format!("unknown kind `{o}`"))),
     })
 }
+
+/// Most points a curved arrow takes (a click per point; more is a mistake, not an arrow).
+pub(crate) const CURVE_ARROW_MAX_POINTS: usize = 64;
+
+/// `widths` stretched (linearly, by position) to `n` values.
+pub(crate) fn resample_widths(widths: &[f64], n: usize) -> Vec<f64> {
+    if widths.is_empty() {
+        return vec![12.0; n];
+    }
+    if widths.len() == n {
+        return widths.to_vec();
+    }
+    (0..n)
+        .map(|i| {
+            if widths.len() == 1 || n == 1 {
+                return widths[0];
+            }
+            let x = i as f64 / (n - 1) as f64 * (widths.len() - 1) as f64;
+            let a = x.floor() as usize;
+            let b = (a + 1).min(widths.len() - 1);
+            widths[a] + (widths[b] - widths[a]) * (x - a as f64)
+        })
+        .collect()
+}
+
+/// The curved arrow of `shape.create {kind: "curveArrow"}` / `shape.edit`: `points` ([[x, y], …],
+/// start first), `widths` (px, one per point; stretched when the count differs), `head` (0 triangle,
+/// 1 barbed, 2 open, 3 none), `headLength`, `headWidth`, `tipRound`, `barbRound` (%), `tail` (0
+/// flat, 1 pointed, 2 arrowhead), `tailRound` (%), `dash` and `gap` (multiples of the width; dash 0 =
+/// solid), `dashRound` (%), `handles` (per point `null` = automatic or `[inX, inY, outX, outY]`,
+/// offsets from the point), `fadeStart` and `fadeEnd` (opacity %, a gradient of the fill along the
+/// arrow below 100), `colors` (per point `null` or a colour, painted along the curve; `pointColor`
+/// with `color` sets one point's). Missing keys keep the previous arrow's values; handles follow their points
+/// (padded with automatic ones when points are added at the end).
+fn curve_arrow_from_params(cmd: &str, p: &Value, prev: Option<&LiveShape>) -> Result<LiveShape> {
+    let prev = match prev {
+        Some(l @ LiveShape::CurveArrow { .. }) => Some(l),
+        _ => None,
+    };
+    let (phandles, pfs, pfe, pcolors) = match prev {
+        Some(LiveShape::CurveArrow { handles, fade_start, fade_end, colors, .. }) => (handles.clone(), *fade_start, *fade_end, colors.clone()),
+        _ => (Vec::new(), 100.0, 100.0, Vec::new()),
+    };
+    let (pp, pw, ph, phl, phw, ptr, pbr, pt_, ptl, pdash, pgap, pdr) = match prev {
+        Some(LiveShape::CurveArrow { points, widths, head, head_length, head_width, tip_round, barb_round, tail, tail_round, dash, gap, dash_round, .. }) => (
+            Some(points.clone()),
+            Some(widths.clone()),
+            *head,
+            *head_length,
+            *head_width,
+            *tip_round,
+            *barb_round,
+            *tail,
+            *tail_round,
+            *dash,
+            *gap,
+            *dash_round,
+        ),
+        _ => (None, None, 0, 42.0, 62.0, 0.0, 0.0, 0, 100.0, 0.0, 1.0, 0.0),
+    };
+    let points: Vec<[f64; 2]> = match p.get("points") {
+        Some(Value::Array(a)) => {
+            let mut out = Vec::with_capacity(a.len());
+            for v in a {
+                let q = pt(v).ok_or_else(|| bad(cmd, "`points` must be [[x, y], …]"))?;
+                if !(q.x.is_finite() && q.y.is_finite()) {
+                    return Err(bad(cmd, "`points` must be finite"));
+                }
+                out.push([q.x, q.y]);
+            }
+            out
+        }
+        Some(_) => return Err(bad(cmd, "`points` must be [[x, y], …]")),
+        None => pp.ok_or_else(|| bad(cmd, "`points`: [[x, y], …] is required"))?,
+    };
+    if points.len() < 2 || points.len() > CURVE_ARROW_MAX_POINTS {
+        return Err(bad(cmd, format!("`points` needs 2 to {CURVE_ARROW_MAX_POINTS} points")));
+    }
+    let widths: Vec<f64> = match p.get("widths") {
+        Some(Value::Array(a)) => {
+            let mut out = Vec::with_capacity(a.len());
+            for v in a {
+                let w = v.as_f64().ok_or_else(|| bad(cmd, "`widths` must be numbers"))?;
+                if !w.is_finite() || !(0.1..=4096.0).contains(&w) {
+                    return Err(bad(cmd, "`widths` must be within 0.1..=4096 px"));
+                }
+                out.push(w);
+            }
+            out
+        }
+        Some(Value::Number(n)) => vec![n.as_f64().unwrap_or(12.0).clamp(0.1, 4096.0); points.len()],
+        Some(_) => return Err(bad(cmd, "`widths` must be numbers")),
+        None => pw.unwrap_or_else(|| vec![12.0, 24.0]),
+    };
+    let widths = resample_widths(&widths, points.len());
+    let num = |key: &str, fallback: f64, min: f64, max: f64| -> Result<f64> {
+        match p.get(key) {
+            Some(v) => {
+                let x = v.as_f64().ok_or_else(|| bad(cmd, format!("`{key}` must be numeric")))?;
+                if !x.is_finite() || !(min..=max).contains(&x) {
+                    return Err(bad(cmd, format!("`{key}` must be within {min}..={max}")));
+                }
+                Ok(x)
+            }
+            None => Ok(if fallback.is_finite() { fallback.clamp(min, max) } else { min }),
+        }
+    };
+    let mut handles: Vec<Option<[f64; 4]>> = match p.get("handles") {
+        Some(Value::Array(a)) => {
+            let mut out = Vec::with_capacity(a.len());
+            for v in a {
+                match v {
+                    Value::Null => out.push(None),
+                    Value::Array(q) if q.len() == 4 => {
+                        let mut h = [0.0; 4];
+                        for (slot, x) in h.iter_mut().zip(q) {
+                            let x = x.as_f64().filter(|x| x.is_finite() && x.abs() <= 1.0e6);
+                            *slot = x.ok_or_else(|| bad(cmd, "`handles` offsets must be finite numbers"))?;
+                        }
+                        out.push(Some(h));
+                    }
+                    _ => return Err(bad(cmd, "`handles` must be [null | [inX, inY, outX, outY], …]")),
+                }
+            }
+            out
+        }
+        Some(Value::Null) => Vec::new(),
+        Some(_) => return Err(bad(cmd, "`handles` must be [null | [inX, inY, outX, outY], …]")),
+        None => phandles,
+    };
+    handles.truncate(points.len());
+    // no handles of its own: stored as none at all
+    if handles.iter().all(Option::is_none) {
+        handles.clear();
+    }
+    let mut colors: Vec<Option<Color>> = match p.get("colors") {
+        Some(Value::Array(a)) => {
+            let mut out = Vec::with_capacity(a.len());
+            for v in a {
+                match v {
+                    Value::Null => out.push(None),
+                    v => out.push(Some(color(v).ok_or_else(|| bad(cmd, "`colors` must be [null | colour, …]"))?)),
+                }
+            }
+            out
+        }
+        Some(Value::Null) => Vec::new(),
+        Some(_) => return Err(bad(cmd, "`colors` must be [null | colour, …]")),
+        None => pcolors,
+    };
+    // one point's colour (the colour picker's answer): `pointColor` its index, `color` the colour
+    if let Some(i) = p.get("pointColor") {
+        let i = i.as_u64().map(|i| i as usize).filter(|i| *i < points.len()).ok_or_else(|| bad(cmd, "`pointColor` must be the index of a point"))?;
+        let c = match p.get("color") {
+            None | Some(Value::Null) => None,
+            Some(v) => Some(color(v).ok_or_else(|| bad(cmd, "`color` must be a colour"))?),
+        };
+        if colors.len() <= i {
+            colors.resize(i + 1, None);
+        }
+        colors[i] = c;
+    }
+    colors.truncate(points.len());
+    if colors.iter().all(Option::is_none) {
+        colors.clear();
+    }
+    Ok(LiveShape::CurveArrow {
+        colors,
+        handles,
+        fade_start: num("fadeStart", pfs, 0.0, 100.0)?,
+        fade_end: num("fadeEnd", pfe, 0.0, 100.0)?,
+        points,
+        widths,
+        head: num("head", f64::from(ph), 0.0, 3.0)?.round() as u8,
+        head_length: num("headLength", phl, 1.0, 8192.0)?,
+        head_width: num("headWidth", phw, 1.0, 8192.0)?,
+        tip_round: num("tipRound", ptr, 0.0, 100.0)?,
+        barb_round: num("barbRound", pbr, 0.0, 100.0)?,
+        tail: num("tail", f64::from(pt_), 0.0, 2.0)?.round() as u8,
+        tail_round: num("tailRound", ptl, 0.0, 100.0)?,
+        dash: num("dash", pdash, 0.0, 100.0)?,
+        gap: num("gap", pgap, 0.0, 100.0)?,
+        dash_round: num("dashRound", pdr, 0.0, 100.0)?,
+    })
+}
