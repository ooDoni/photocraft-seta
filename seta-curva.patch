+        assert_eq!(hit_point(&a, [50.0, 1.0], 5.0), None);
+        assert!(hit_curve(&a, [50.0, 2.0], 5.0).is_some_and(|(seg, t)| seg == 0 && (t - 0.5).abs() < 0.05));
+        // the selected point's handles: none before the start, the outgoing one after it
+        let h = a.knots()[0].o;
+        assert_eq!(hit_handle(&a, 0, h, 4.0), Some(true));
+        let bent = Arrow { handles: vec![Some([0.0, 0.0, 30.0, -40.0]), None], ..a.clone() };
+        assert_eq!(bent.knots()[0].o, [30.0, -40.0]);
+        assert_eq!(hit_handle(&bent, 0, [30.0, -40.0], 4.0), Some(true));
+        assert!(bent.custom(0) && !bent.custom(1));
+    }
+}
