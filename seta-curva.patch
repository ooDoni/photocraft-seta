+            }
+            if o.dash > 0.0 {
+                let _ = option_cells::number(tl!("Traço:"), &mut o.dash, 0.1..=50.0)
+                    .unit("×")
+                    .popup_slider()
+                    .tooltip(tl!("Comprimento de cada traço, em espessuras da linha"))
