--- /dev/null
+++ b/crates/format/tests/it/curve_arrow_live.rs
@@ -0,0 +1,48 @@
+//! A curved arrow (the Curved Arrow tool) is saved in `curve_arrow_live`, beside `live`, so other
+//! builds still open the file and show the saved path, and this build gets the editable arrow back.
+
+use photocraft_color::{ColorMode, SampleType};
+use photocraft_doc::{Document, Fill, Layer, LayerContent, LiveShape, Path, ShapeLayer, Subpath};
+use photocraft_format::*;
+use serde_json::Value;
+
+fn arrow() -> LiveShape {
+    LiveShape::CurveArrow {
+        points: vec![[10.0, 200.0], [120.0, 20.0], [260.0, 160.0]],
+        widths: vec![10.0, 20.0, 30.0],
+        head: 1,
+        head_length: 50.0,
+        head_width: 70.0,
+        tip_round: 30.0,
+        barb_round: 10.0,
+        tail: 0,
+        tail_round: 100.0,
+        dash: 2.0,
+        gap: 1.0,
+        dash_round: 50.0,
+        handles: vec![None, Some([-40.0, 5.0, 60.0, -8.0]), None],
+        fade_start: 20.0,
+        fade_end: 100.0,
+    }
+}
+
+fn document() -> Document {
+    let mut doc = Document::new("Seta", photocraft_doc::Size::new(400, 300), ColorMode::Rgb, SampleType::U8);
+    let path = Path::new(vec![Subpath::polygon(&[(10.0, 10.0), (60.0, 10.0), (30.0, 50.0)])]);
+    doc.layers.push(Layer::new(
+        "Seta 1",
+        LayerContent::Shape(ShapeLayer { path, fill: Some(Fill::Solid(photocraft_doc::Color::BLACK)), live: Some(arrow()), ..Default::default() }),
+    ));
+    doc
+}
+
+#[test]
+fn a_curved_arrow_round_trips_and_older_builds_see_only_the_path() {
+    let doc = document();
+    let bytes = save_to_bytes(&doc, &SaveOptions::default()).unwrap();
+    assert_eq!(load_from_bytes(&bytes).unwrap(), doc);
+    let json = serde_json::to_value(read_manifest(&bytes).unwrap()).unwrap();
+    let saved: &Value = &json["document"]["layers"][0]["content"];
+    assert!(saved["live"].is_null());
+    assert_eq!(saved["curve_arrow_live"]["kind"], "curveArrow");
+}
