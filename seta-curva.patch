+        let w = tapered(&[[0.0, 0.0], [10.0, 0.0], [100.0, 0.0]], &[], 10.0, 20.0);
+        assert!((w[0] - 10.0).abs() < 1e-9 && (w[2] - 20.0).abs() < 1e-9);
+        assert!(w[1] > 10.0 && w[1] < 12.0);
