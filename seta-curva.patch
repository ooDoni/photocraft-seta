 /// Re-renders a shape layer's cache for `doc` (canvas-clipped, document pixel format).
 pub fn refresh_shape(doc: &Document, sh: &mut ShapeLayer) {
+    fit_arrow_fade(sh);
     sh.cache = Some(vector::render_shape(sh, doc.pixel_format(), doc.bounds()));
 }
 
+/// Whether a live shape is a Curved Arrow that fades (an end below 100 % opacity).
+fn arrow_fades(live: Option<&LiveShape>) -> bool {
+    matches!(live, Some(LiveShape::CurveArrow { fade_start, fade_end, .. }) if *fade_start < 99.95 || *fade_end < 99.95)
+}
+
+/// A fading Curved Arrow's fill: a linear gradient of its colour from the start's opacity at its
+/// first point to the tip's at its last, recomputed whenever the arrow or its colour changes (a
+/// solid colour set on it keeps fading). Other shapes are left alone.
+fn fit_arrow_fade(sh: &mut ShapeLayer) {
+    if !arrow_fades(sh.live.as_ref()) {
+        return;
+    }
+    let Some(LiveShape::CurveArrow { points, fade_start, fade_end, .. }) = &sh.live else { return };
+    let (Some(a), Some(b)) = (points.first(), points.last()) else { return };
+    let color = match &sh.fill {
+        Some(Fill::Solid(c)) => *c,
+        Some(Fill::Gradient { stops, .. }) => match stops.first() {
+            Some((_, c)) => *c,
+            None => return,
+        },
+        _ => return,
+    };
+    // laid out as the shape renderer does: in the path's control bounds
+    let Some((x0, y0, x1, y1)) = sh.path.control_bounds() else { return };
+    let (w, h) = ((x1 - x0).max(1.0), (y1 - y0).max(1.0));
+    let (dx, dy) = (b[0] - a[0], b[1] - a[1]);
+    let len = dx.hypot(dy);
+    if !(len >= 1.0 && len.is_finite()) {
+        return;
+    }
+    let angle = (-dy).atan2(dx);
+    let (sin, cos) = angle.sin_cos();
+    let chord = (w / cos.abs().max(1e-6)).min(h / sin.abs().max(1e-6)).max(1.0);
+    let mid = ((a[0] + b[0]) / 2.0, (a[1] + b[1]) / 2.0);
+    let offset = (((mid.0 - (x0 + w / 2.0)) / w) as f32, ((mid.1 - (y0 + h / 2.0)) / h) as f32);
+    let opacity = |v: f64| (v.clamp(0.0, 100.0) / 100.0) as f32;
+    sh.fill = Some(Fill::Gradient {
+        stops: vec![(0.0, color), (1.0, color)],
+        angle: angle.to_degrees() as f32,
+        scale: (len / chord) as f32,
+        style: photocraft_doc::GradientStyle::Linear,
+        reverse: false,
+        opacity_stops: vec![(0.0, opacity(*fade_start)), (1.0, opacity(*fade_end))],
+        midpoints: Vec::new(),
+        offset,
+        dither: false,
+        align: true,
+    });
+}
