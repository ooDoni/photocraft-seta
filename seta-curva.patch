+        /// Dash length in multiples of the width (0 = solid line).
+        #[serde(default)]
+        dash: f64,
+        /// Gap between dashes in multiples of the width.
+        #[serde(default)]
+        gap: f64,
+        /// Rounding of the dashes' ends (%).
+        #[serde(default)]
+        dash_round: f64,
+        /// Per point, the curve's handles as offsets from the point, `[in x, in y, out x, out y]`;
+        /// `None` (or no entry) = automatic, smooth through the neighbouring points.
+        #[serde(default)]
+        handles: Vec<Option<[f64; 4]>>,
+        /// Opacity (%) at the start and at the tip: below 100 the fill becomes a gradient of its
+        /// colour from one to the other, laid along the arrow.
+        #[serde(default = "full_percent")]
+        fade_start: f64,
+        #[serde(default = "full_percent")]
+        fade_end: f64,
+    },
+}
+
+fn full_percent() -> f64 {
