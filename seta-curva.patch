+//! Curved Arrow tool ("Seta"): click points on the canvas and a filled arrow follows a smooth
+//! curve through them, as a live `CurveArrow` shape layer (`shape.create {kind: "curveArrow"}`).
+//!
+//! - Click: the first click marks the start, the second makes the arrow, every next click adds a
+//!   point at the head end. Enter, Escape or a double click ends the arrow.
+//! - With the arrow's layer active: drag a point to move it, Alt+click (or Delete on the selected
+//!   point) removes it, a click on the curve adds a point there. The selected point shows its two
+//!   curve handles, as the Pen tool's: dragging one bends the curve (the other turns with it;
+//!   Alt moves only the one). A click elsewhere starts a new arrow, which takes the selected
+//!   arrow's style (layer style, colour, head).
+//! - The options bar sets the widths (start, end, the selected point), the head (shape, length,
+//!   width, rounding of its tip and barbs), the start (flat, pointed, arrowhead) and its rounding,
+//!   and flips the direction, the line (solid, dashed, dotted) and the opacity at either end.
+//!   With an arrow selected it edits that arrow.
+
+use std::sync::Mutex;
+
+use craft::behavior::kurbo::Point;
+use craft::behavior::{CancelReason, Cursor, CursorIcon, GesturePhase, PointerButton};
+use craft::keymap::Mods;
+use craft::ui::buttons::Button;
+use craft::ui::choice::Segmented;
+use craft::ui::canvas::{CanvasTool, ToolAction, ToolClaims, ToolContext, ToolHostResponse, ToolKey, ToolPath, ToolPointer};
+use craft::ui::contract::{Bind, Entry, Props as _, Show as _};
+use craft::ui::display::Divider;
+use craft::ui::pickers::Select;
+use craft::ui::primitives::{DataWidth, Draw, PaintShape};
+use craft::ui::runtime::env::Label;
+use craft::ui::style::DataColor;
+use egui::{Color32, Pos2};
+use photocraft_doc::vector::LiveShape;
+use photocraft_doc::{LayerContent, LayerId};
+use photocraft_vector::curve_arrow as geo;
+use serde_json::{Value, json};
+
+use super::option_cells;
+use crate::PhotocraftApp;
+use crate::canvas::document_display::CanvasHost;
+use crate::canvas::tools::{FamilyTool, ToolScope};
+use crate::state::Tool;
+
+// ------------------------------------------------------------------ options
+
+/// The arrow a new arrow gets (the options bar edits these when no arrow is selected).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ArrowOptions {
+    pub start_width: f32,
+    pub end_width: f32,
+    pub head: u8,
+    pub head_length: f32,
+    pub head_width: f32,
+    pub tip_round: f32,
+    pub barb_round: f32,
+    pub tail: u8,
+    pub tail_round: f32,
+    /// Dash and gap in multiples of the width (dash 0 = solid), rounding of the dash ends (%).
+    pub dash: f32,
+    pub gap: f32,
+    pub dash_round: f32,
+    /// Opacity (%) at the start and at the tip.
+    pub fade_start: f32,
+    pub fade_end: f32,
+}
+
+impl Default for ArrowOptions {
+    fn default() -> Self {
+        ArrowOptions {
+            start_width: 20.0,
+            end_width: 40.0,
+            head: geo::HEAD_TRIANGLE,
+            head_length: 75.0,
+            head_width: 110.0,
+            tip_round: 0.0,
+            barb_round: 0.0,
+            tail: geo::TAIL_FLAT,
+            tail_round: 100.0,
+            dash: 0.0,
+            gap: 1.0,
+            dash_round: 0.0,
+            fade_start: 100.0,
+            fade_end: 100.0,
+        }
+    }
+}
+
+/// Shared between the canvas tool and the options bar (both run on the UI thread).
+#[derive(Default)]
+struct Shared {
+    options: Option<ArrowOptions>,
+    /// The selected point of an arrow: its layer and index.
+    selected: Option<(LayerId, usize)>,
+    /// Counter for history-coalescing keys: one key per gesture.
+    gesture: u64,
+    /// Which group of settings the options bar shows: 0 head, 1 start, 2 line, 3 opacity.
+    section: u8,
+}
+
+static SHARED: Mutex<Shared> = Mutex::new(Shared { options: None, selected: None, gesture: 0, section: 0 });
+
+fn shared<R>(f: impl FnOnce(&mut Shared) -> R) -> R {
+    let mut guard = match SHARED.lock() {
+        Ok(g) => g,
+        Err(poisoned) => poisoned.into_inner(),
+    };
+    f(&mut guard)
+}
+
+fn options() -> ArrowOptions {
+    shared(|s| *s.options.get_or_insert_with(ArrowOptions::default))
+}
+
+fn set_options(o: ArrowOptions) {
+    shared(|s| s.options = Some(o));
+}
+
+fn selected() -> Option<(LayerId, usize)> {
+    shared(|s| s.selected)
+}
+
+fn select(sel: Option<(LayerId, usize)>) {
+    shared(|s| s.selected = sel);
+}
+
+fn next_key(what: &str) -> String {
+    let n = shared(|s| {
+        s.gesture = s.gesture.wrapping_add(1);
+        s.gesture
+    });
+    format!("curveArrow.{what}.{n}")
+}
+
+// ------------------------------------------------------------------ the arrow on the layer
+
+/// A curved arrow as stored on its layer.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Arrow {
+    pub id: LayerId,
+    pub points: Vec<[f64; 2]>,
+    pub widths: Vec<f64>,
+    pub head: u8,
+    pub head_length: f64,
+    pub head_width: f64,
+    pub tip_round: f64,
+    pub barb_round: f64,
+    pub tail: u8,
+    pub tail_round: f64,
+    pub dash: f64,
+    pub gap: f64,
+    pub dash_round: f64,
+    pub handles: Vec<Option<[f64; 4]>>,
+    pub fade_start: f64,
+    pub fade_end: f64,
+}
+
+fn arrow_of(id: LayerId, live: &LiveShape) -> Option<Arrow> {
+    match live {
+        LiveShape::CurveArrow { points, widths, head, head_length, head_width, tip_round, barb_round, tail, tail_round, dash, gap, dash_round, handles, fade_start, fade_end } => Some(Arrow {
+            id,
+            points: points.clone(),
+            widths: widths.clone(),
+            head: *head,
+            head_length: *head_length,
+            head_width: *head_width,
+            tip_round: *tip_round,
+            barb_round: *barb_round,
+            tail: *tail,
+            tail_round: *tail_round,
+            dash: *dash,
+            gap: *gap,
+            dash_round: *dash_round,
+            handles: handles.clone(),
+            fade_start: *fade_start,
+            fade_end: *fade_end,
+        }),
+        _ => None,
+    }
+}
+
+impl Arrow {
+    /// The knots of its centre curve (anchor, incoming and outgoing control points).
+    fn knots(&self) -> Vec<geo::Anchor> {
+        geo::anchors(&self.points, &self.handles)
+    }
+
+    /// Its handles, one entry per point (automatic ones as `None`).
+    fn handle_list(&self) -> Vec<Option<[f64; 4]>> {
+        let mut h = self.handles.clone();
+        h.resize(self.points.len(), None);
+        h
+    }
+
+    /// Whether point `i` has handles of its own.
+    fn custom(&self, i: usize) -> bool {
+        self.handles.get(i).is_some_and(Option::is_some)
+    }
+}
+
+/// Point `i`'s handles as offsets, `[in x, in y, out x, out y]`, as the curve uses them now.
+fn offsets(k: &geo::Anchor) -> [f64; 4] {
+    [k.i[0] - k.a[0], k.i[1] - k.a[1], k.o[0] - k.a[0], k.o[1] - k.a[1]]
+}
+
+/// The active layer's arrow, if the active layer is one.
+pub(crate) fn active_arrow(app: &PhotocraftApp) -> Option<Arrow> {
+    let st = app.session.active()?;
+    let id = st.active_layer?;
+    let layer = st.doc.layer(id)?;
+    let LayerContent::Shape(sh) = &layer.content else { return None };
+    arrow_of(id, sh.live.as_ref()?)
+}
+
+fn report(app: &mut PhotocraftApp, r: Result<Value, String>) -> Option<Value> {
+    match r {
+        Ok(v) => Some(v),
+        Err(e) => {
+            app.ui.status = e;
+            app.ui.status_error = true;
+            None
+        }
+    }
+}
+
+fn edit(app: &mut PhotocraftApp, id: LayerId, mut patch: Value, coalesce: Option<&str>) {
+    if let Some(o) = patch.as_object_mut() {
+        o.insert("layer".into(), json!(id.0));
+        if let Some(key) = coalesce {
+            o.insert("coalesce".into(), json!(key));
+        }
+    }
+    let r = app.run("shape.edit", patch);
+    let _ = report(app, r);
+}
+
+/// Widths from `start` to `end` along the curve through `points` (by arc length).
+fn tapered(points: &[[f64; 2]], handles: &[Option<[f64; 4]>], start: f64, end: f64) -> Vec<f64> {
+    let fr = fractions(points, handles);
+    fr.iter().map(|f| ((start + (end - start) * f) * 10.0).round() / 10.0).collect()
+}
+
+/// Where each point sits along the curve, 0 at the start and 1 at the head.
+fn fractions(points: &[[f64; 2]], handles: &[Option<[f64; 4]>]) -> Vec<f64> {
+    let segs = geo::guide_segments(points, handles);
+    let mut lens = vec![0.0];
+    let mut total = 0.0;
+    for s in &segs {
+        total += bez_len(s);
+        lens.push(total);
+    }
+    if total <= 1e-9 {
+        let n = points.len().max(2) - 1;
+        return (0..points.len()).map(|i| i as f64 / n as f64).collect();
+    }
+    lens.iter().map(|l| l / total).collect()
+}
+
+fn bez_at(s: &[[f64; 2]; 4], t: f64) -> [f64; 2] {
+    let mt = 1.0 - t;
+    let (a, b, c, d) = (mt * mt * mt, 3.0 * mt * mt * t, 3.0 * mt * t * t, t * t * t);
+    [a * s[0][0] + b * s[1][0] + c * s[2][0] + d * s[3][0], a * s[0][1] + b * s[1][1] + c * s[2][1] + d * s[3][1]]
+}
+
+fn bez_len(s: &[[f64; 2]; 4]) -> f64 {
+    let mut len = 0.0;
+    let mut prev = s[0];
+    for k in 1..=24 {
+        let q = bez_at(s, f64::from(k) / 24.0);
+        len += dist(prev, q);
+        prev = q;
+    }
+    len
+}
+
+fn dist(a: [f64; 2], b: [f64; 2]) -> f64 {
+    (a[0] - b[0]).hypot(a[1] - b[1])
+}
+
+/// The style params of a new arrow: the arrow it continues from (`from`), else the bar's options.
+fn style_params(from: Option<&Arrow>) -> Value {
+    match from {
+        Some(a) => json!({
+            "head": a.head, "headLength": a.head_length, "headWidth": a.head_width, "tipRound": a.tip_round,
+            "barbRound": a.barb_round, "tail": a.tail, "tailRound": a.tail_round,
+            "dash": a.dash, "gap": a.gap, "dashRound": a.dash_round,
+            "fadeStart": a.fade_start, "fadeEnd": a.fade_end,
+        }),
+        None => {
+            let o = options();
+            json!({
+                "head": o.head, "headLength": o.head_length, "headWidth": o.head_width, "tipRound": o.tip_round,
+                "barbRound": o.barb_round, "tail": o.tail, "tailRound": o.tail_round,
+                "dash": o.dash, "gap": o.gap, "dashRound": o.dash_round,
+                "fadeStart": o.fade_start, "fadeEnd": o.fade_end,
+            })
+        }
+    }
+}
+
+/// Makes the arrow `points` (two) above the active layer. When the active layer is an arrow, the
+/// new one takes its look: head, widths, fill and layer style. Returns the new layer.
+fn create(app: &mut PhotocraftApp, points: [[f64; 2]; 2]) -> Option<LayerId> {
+    let from = active_arrow(app);
+    let (ws, we) = match &from {
+        Some(a) => (a.widths.first().copied().unwrap_or(20.0), a.widths.last().copied().unwrap_or(40.0)),
+        None => {
+            let o = options();
+            (f64::from(o.start_width), f64::from(o.end_width))
+        }
+    };
+    let mut p = style_params(from.as_ref());
+    if let Some(o) = p.as_object_mut() {
+        o.insert("kind".into(), json!("curveArrow"));
+        o.insert("points".into(), json!(points));
+        o.insert("widths".into(), json!([ws, we]));
+    }
+    // The fill of the arrow it continues from, and its layer style afterwards.
+    if let Some(a) = &from {
+        let info = app.run("shape.info", json!({"layer": a.id.0})).ok();
+        if let Some(fill) = info.as_ref().and_then(|i| i.get("fill")).filter(|f| !f.is_null())
+            && let Some(o) = p.as_object_mut()
+        {
+            o.insert("fill".into(), fill.clone());
+        }
+    }
+    let made = match app.run("shape.create", p.clone()) {
+        Ok(v) => Some(v),
+        Err(_) if p.get("fill").is_some() => {
+            // A fill this command can't read back: the foreground colour instead.
+            if let Some(o) = p.as_object_mut() {
+                o.remove("fill");
+            }
+            let r = app.run("shape.create", p);
+            report(app, r)
+        }
+        Err(e) => report(app, Err(e)),
+    }?;
+    let id = LayerId(made.get("layer").and_then(Value::as_u64)?);
+    if let Some(a) = &from
+        && app.run("layer.layerStyle.copyLayerStyle", json!({"layer": a.id.0})).is_ok()
+    {
+        let _ = app.run("layer.layerStyle.pasteLayerStyle", json!({"layer": id.0}));
+    }
+    Some(id)
+}
+
+/// Adds `at` as the arrow's new last point (the head end); the widths taper from the start to the
+/// end width again.
+fn append(app: &mut PhotocraftApp, arrow: &Arrow, at: [f64; 2]) {
+    if arrow.points.len() >= 64 {
+        return;
+    }
+    let mut points = arrow.points.clone();
+    points.push(at);
+    let mut handles = arrow.handle_list();
+    handles.push(None);
+    let ws = arrow.widths.first().copied().unwrap_or(20.0);
+    let we = arrow.widths.last().copied().unwrap_or(40.0);
+    let widths = tapered(&points, &handles, ws, we);
+    edit(app, arrow.id, json!({"points": points, "widths": widths, "handles": handles}), None);
+    select(Some((arrow.id, points.len() - 1)));
+}
+
+fn remove_point(app: &mut PhotocraftApp, arrow: &Arrow, index: usize) {
+    if arrow.points.len() <= 2 || index >= arrow.points.len() {
+        return;
+    }
+    let mut points = arrow.points.clone();
+    let mut widths = arrow.widths.clone();
+    points.remove(index);
+    if index < widths.len() {
+        widths.remove(index);
+    }
+    let mut handles = arrow.handle_list();
+    handles.remove(index);
+    edit(app, arrow.id, json!({"points": points, "widths": widths, "handles": handles}), None);
+    select(None);
+}
+
+/// Inserts a point on the curve between `seg` and `seg + 1` (at parameter `t` of that segment),
+/// its width in between. Next to a point with handles of its own the segment is split exactly, so
+/// the curve keeps its shape.
+fn insert_point(app: &mut PhotocraftApp, arrow: &Arrow, seg: usize, t: f64) -> Option<usize> {
+    if arrow.points.len() >= 64 || seg + 1 >= arrow.points.len() {
+        return None;
+    }
+    let knots = arrow.knots();
+    let (k0, k1) = (knots.get(seg)?, knots.get(seg + 1)?);
+    let lerp = |a: [f64; 2], b: [f64; 2]| [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
+    let (p01, p12, p23) = (lerp(k0.a, k0.o), lerp(k0.o, k1.i), lerp(k1.i, k1.a));
+    let (p012, p123) = (lerp(p01, p12), lerp(p12, p23));
+    let at = lerp(p012, p123);
+    let mut points = arrow.points.clone();
+    let mut widths = arrow.widths.clone();
+    let w = match (widths.get(seg), widths.get(seg + 1)) {
+        (Some(a), Some(b)) => ((a + b) * 5.0).round() / 10.0,
+        _ => widths.last().copied().unwrap_or(20.0),
+    };
+    points.insert(seg + 1, at);
+    widths.insert((seg + 1).min(widths.len()), w);
+    let mut handles = arrow.handle_list();
+    if arrow.custom(seg) || arrow.custom(seg + 1) {
+        let off = |p: [f64; 2], a: [f64; 2]| [p[0] - a[0], p[1] - a[1]];
+        let (o0, o1) = (offsets(k0), offsets(k1));
+        let (a_out, b_in) = (off(p01, k0.a), off(p23, k1.a));
+        let (m_in, m_out) = (off(p012, at), off(p123, at));
+        handles[seg] = Some([o0[0], o0[1], a_out[0], a_out[1]]);
+        handles[seg + 1] = Some([b_in[0], b_in[1], o1[2], o1[3]]);
+        handles.insert(seg + 1, Some([m_in[0], m_in[1], m_out[0], m_out[1]]));
+    } else {
+        handles.insert(seg + 1, None);
+    }
+    edit(app, arrow.id, json!({"points": points, "widths": widths, "handles": handles}), None);
+    Some(seg + 1)
+}
+
+/// Moves one handle of point `i` to `at` (document units). The other handle turns to stay in line
+/// (a smooth point) unless `alone`.
+fn move_handle(app: &mut PhotocraftApp, arrow: &Arrow, i: usize, out: bool, at: [f64; 2], alone: bool, key: &str) {
+    let knots = arrow.knots();
+    let Some(k) = knots.get(i) else { return };
+    let mut h = offsets(k);
+    let v = [at[0] - k.a[0], at[1] - k.a[1]];
+    let (mine, other) = if out { (2, 0) } else { (0, 2) };
+    h[mine] = v[0];
+    h[mine + 1] = v[1];
+    if !alone {
+        let len = v[0].hypot(v[1]);
+        let keep = h[other].hypot(h[other + 1]);
+        let keep = if keep > 0.5 { keep } else { len };
+        if len > 1e-6 {
+            h[other] = -v[0] / len * keep;
+            h[other + 1] = -v[1] / len * keep;
+        }
+    }
+    let mut handles = arrow.handle_list();
+    if let Some(slot) = handles.get_mut(i) {
+        *slot = Some(h);
+    }
+    edit(app, arrow.id, json!({"handles": handles}), Some(key));
+}
+
+/// The handle of the selected point `sel` under `at`: whether it is the outgoing one.
+fn hit_handle(arrow: &Arrow, sel: usize, at: [f64; 2], reach: f64) -> Option<bool> {
+    let k = *arrow.knots().get(sel)?;
+    let last = arrow.points.len().saturating_sub(1);
+    let mut best: Option<(f64, bool)> = None;
+    for (out, p, shown) in [(false, k.i, sel > 0), (true, k.o, sel < last)] {
+        let d = dist(p, at);
+        if shown && dist(p, k.a) > 0.5 && d <= reach && best.is_none_or(|b| d < b.0) {
+            best = Some((d, out));
+        }
+    }
+    best.map(|b| b.1)
+}
+
+/// The point of `arrow` within `reach` document units of `at`.
+fn hit_point(arrow: &Arrow, at: [f64; 2], reach: f64) -> Option<usize> {
+    arrow
+        .points
+        .iter()
+        .enumerate()
+        .map(|(i, p)| (i, dist(*p, at)))
+        .filter(|(_, d)| *d <= reach)
+        .min_by(|a, b| a.1.total_cmp(&b.1))
+        .map(|(i, _)| i)
+}
+
+/// The curve segment under `at` (within `reach`), with the parameter of the nearest point on it.
+fn hit_curve(arrow: &Arrow, at: [f64; 2], reach: f64) -> Option<(usize, f64)> {
+    let mut best: Option<(f64, usize, f64)> = None;
+    for (i, s) in geo::guide_segments(&arrow.points, &arrow.handles).iter().enumerate() {
+        for k in 0..=96 {
+            let t = f64::from(k) / 96.0;
+            let d = dist(bez_at(s, t), at);
+            if d <= reach && best.is_none_or(|b| d < b.0) {
+                best = Some((d, i, t));
+            }
+        }
+    }
+    best.map(|b| (b.1, b.2))
+}
+
+// ------------------------------------------------------------------ the canvas tool
+
+/// The tool's state between passes, kept in `CanvasTools::curve_arrow`.
+#[derive(Debug, Default)]
+pub(crate) struct CurveArrowTool {
+    /// The first click of a new arrow; the layer is made at the second.
+    pending: Option<[f64; 2]>,
+    /// The arrow being drawn: clicks add points to it.
+    drawing: Option<LayerId>,
+    /// The point a drag moves: layer, index, the history key of the drag.
+    dragging: Option<(LayerId, usize, String)>,
+    /// The handle a drag moves: layer, point, whether the outgoing one, the history key.
+    bending: Option<(LayerId, usize, bool, String)>,
+    /// The pointer over the canvas, in document units (the rubber band).
+    hover: Option<[f64; 2]>,
+}
+
+impl CurveArrowTool {
+    fn finish(&mut self) -> bool {
+        let had = self.pending.is_some() || self.drawing.is_some();
+        self.pending = None;
+        self.drawing = None;
+        had
+    }
+}
+
+/// The Curved Arrow tool for one pass.
+pub(crate) fn tool<'a>(scope: &'a ToolScope<'a>, state: &'a mut CurveArrowTool, _host: CanvasHost) -> FamilyTool<'a> {
+    Box::new(ArrowPass { scope, state })
+}
+
+/// After the host ran: ends a drag the host ended, and the arrow in progress when the tool or the
+/// active layer changed.
+pub(crate) fn drain(app: &mut PhotocraftApp, state: &mut CurveArrowTool, response: &ToolHostResponse) {
+    if matches!(response.gesture, Some(GesturePhase::Commit | GesturePhase::Cancel)) {
+        state.dragging = None;
+        state.bending = None;
+    }
+    if app.ui.tool != Tool::CurveArrow {
+        state.finish();
+        state.dragging = None;
+        state.bending = None;
+        state.hover = None;
+        return;
+    }
+    let active = app.session.active().and_then(|st| st.active_layer);
+    if let Some(id) = state.drawing
+        && active != Some(id)
+    {
+        state.drawing = None;
+    }
+    if let Some((id, _)) = selected()
+        && active != Some(id)
+    {
+        select(None);
+    }
+}
+
+struct ArrowPass<'a> {
+    scope: &'a ToolScope<'a>,
+    state: &'a mut CurveArrowTool,
+}
+
+fn doc_at(cx: &ToolContext<'_>, pos: Pos2) -> Option<[f64; 2]> {
+    let p = cx.space()?.view.to_doc(pos);
+    (p.x.is_finite() && p.y.is_finite()).then_some([p.x, p.y])
+}
+
+fn reach(cx: &ToolContext<'_>) -> f64 {
+    cx.space().map_or(6.0, |s| s.view.doc_len(cx.reach().max(6.0)))
+}
+
+impl CanvasTool for ArrowPass<'_> {
+    fn press(&mut self, pointer: &ToolPointer, cx: &mut ToolContext<'_>) -> ToolAction {
+        let Some(at) = doc_at(cx, pointer.pos) else { return ToolAction::Ignored };
+        let reach = reach(cx);
+        let state = &mut *self.state;
+        self.scope.with_app(|app| {
+            let arrow = active_arrow(app);
+            // A double click ends the arrow being drawn (its first click already added the point).
+            if pointer.clicks >= 2 && state.drawing.is_some() {
+                state.finish();
+                return ToolAction::Done;
+            }
+            if let Some(arrow) = &arrow {
+                if let Some((_, i)) = selected().filter(|(id, _)| *id == arrow.id)
+                    && let Some(out) = hit_handle(arrow, i, at, reach)
+                {
+                    state.bending = Some((arrow.id, i, out, next_key("bend")));
+                    return ToolAction::Claimed;
+                }
+                if let Some(i) = hit_point(arrow, at, reach) {
+                    if pointer.mods.alt {
+                        remove_point(app, arrow, i);
+                        return ToolAction::Done;
+                    }
+                    select(Some((arrow.id, i)));
+                    state.dragging = Some((arrow.id, i, next_key("move")));
+                    return ToolAction::Claimed;
+                }
+                if state.drawing == Some(arrow.id) {
+                    append(app, arrow, at);
+                    return ToolAction::Done;
+                }
+                if !pointer.mods.alt
+                    && let Some((seg, t)) = hit_curve(arrow, at, reach)
+                    && let Some(i) = insert_point(app, arrow, seg, t)
+                {
+                    select(Some((arrow.id, i)));
+                    state.dragging = Some((arrow.id, i, next_key("move")));
+                    return ToolAction::Claimed;
+                }
+            }
+            if pointer.mods.alt {
+                return ToolAction::Done;
+            }
+            match state.pending.take() {
+                Some(first) if dist(first, at) >= 1.0 => {
+                    if let Some(id) = create(app, [first, at]) {
+                        state.drawing = Some(id);
+                        select(Some((id, 1)));
+                    }
+                }
+                _ => {
+                    state.pending = Some(at);
+                    state.drawing = None;
+                    select(None);
+                }
+            }
+            ToolAction::Done
+        })
+    }
+
+    fn drag(&mut self, pointer: &ToolPointer, cx: &mut ToolContext<'_>) {
+        if let Some((id, index, out, key)) = self.state.bending.clone() {
+            let Some(at) = doc_at(cx, pointer.pos) else { return };
+            self.state.hover = Some(at);
+            let alone = pointer.mods.alt;
+            self.scope.with_app(|app| {
+                if let Some(arrow) = active_arrow(app).filter(|a| a.id == id) {
+                    move_handle(app, &arrow, index, out, at, alone, &key);
+                }
+            });
+            return;
+        }
+        let Some((id, index, key)) = self.state.dragging.clone() else { return };
+        let Some(at) = doc_at(cx, pointer.pos) else { return };
+        self.state.hover = Some(at);
+        self.scope.with_app(|app| {
+            let Some(arrow) = active_arrow(app).filter(|a| a.id == id) else { return };
+            let Some(old) = arrow.points.get(index) else { return };
+            if dist(*old, at) < 0.25 {
+                return;
+            }
+            let mut points = arrow.points.clone();
+            points[index] = at;
+            edit(app, id, json!({"points": points}), Some(&key));
+        });
+    }
+
+    fn release(&mut self, pointer: &ToolPointer, cx: &mut ToolContext<'_>) {
+        self.drag(pointer, cx);
+        self.state.dragging = None;
+        self.state.bending = None;
+    }
+
+    fn hover(&mut self, pointer: &ToolPointer, cx: &mut ToolContext<'_>) {
+        self.state.hover = doc_at(cx, pointer.pos);
+    }
+
+    fn cancel(&mut self, _reason: CancelReason, _cx: &mut ToolContext<'_>) {
+        self.state.dragging = None;
+        self.state.bending = None;
+    }
+
+    fn claims(&self) -> ToolClaims {
+        if selected().is_some() { ToolClaims::NONE.deletes() } else { ToolClaims::NONE }
+    }
+
+    fn key(&mut self, key: &ToolKey, _cx: &mut ToolContext<'_>) -> bool {
+        match key {
+            ToolKey::Submit | ToolKey::Cancel => self.state.finish(),
+            ToolKey::Delete { .. } => {
+                let Some((id, i)) = selected() else { return false };
+                self.scope.with_app(|app| {
+                    let Some(arrow) = active_arrow(app).filter(|a| a.id == id) else { return false };
+                    remove_point(app, &arrow, i);
+                    true
+                })
+            }
+            _ => false,
+        }
+    }
+
+    fn paint(&self, draw: &Draw<'_>, cx: &ToolContext<'_>) {
+        let Some(space) = cx.space() else { return };
+        let screen = |p: [f64; 2]| space.view.to_screen(Point::new(p[0], p[1]));
+        let dark = DataColor::new(Color32::from_black_alpha(150));
+        let light = DataColor::new(Color32::WHITE);
+        let accent = DataColor::new(Color32::from_rgb(0x2d, 0x8c, 0xff));
+        let start_col = DataColor::new(Color32::from_rgb(0x34, 0xc7, 0x59));
+        let head_col = DataColor::new(Color32::from_rgb(0xff, 0x8a, 0x00));
+        let line = |pts: &[Pos2]| {
+            if pts.len() >= 2 {
+                draw.stroke(&PaintShape::Path(pts.to_vec()), DataWidth::points(3.0), dark);
+                draw.stroke(&PaintShape::Path(pts.to_vec()), DataWidth::points(1.0), light);
+            }
+        };
+        let handle = |p: Pos2, fill: DataColor, r: f32| {
+            draw.data_fill(&PaintShape::Circle(p, r + 1.5), dark);
+            draw.data_fill(&PaintShape::Circle(p, r), fill);
+        };
+        let arrow = self.scope.with_app(|app| active_arrow(app));
+        let sel = selected();
+        if let Some(arrow) = &arrow {
+            let mut pts: Vec<Pos2> = Vec::new();
+            for s in geo::guide_segments(&arrow.points, &arrow.handles) {
+                for k in 0..=24 {
+                    pts.push(screen(bez_at(&s, f64::from(k) / 24.0)));
+                }
+            }
+            line(&pts);
+            let last = arrow.points.len().saturating_sub(1);
+            // the selected point's curve handles
+            if let Some((_, i)) = sel.filter(|(id, _)| *id == arrow.id)
+                && let Some(k) = arrow.knots().get(i).copied()
+            {
+                let knob = if arrow.custom(i) { light } else { DataColor::new(Color32::from_gray(200)) };
+                for (p, shown) in [(k.i, i > 0), (k.o, i < last)] {
+                    if shown && dist(p, k.a) > 0.5 {
+                        line(&[screen(k.a), screen(p)]);
+                        let c = screen(p);
+                        draw.data_fill(&PaintShape::Circle(c, 4.5), dark);
+                        draw.data_fill(&PaintShape::Circle(c, 3.0), knob);
+                        draw.data_fill(&PaintShape::Circle(c, 1.5), accent);
+                    }
+                }
+            }
+            for (i, p) in arrow.points.iter().enumerate() {
+                let fill = if sel == Some((arrow.id, i)) {
+                    accent
+                } else if i == 0 {
+                    start_col
+                } else if i == last {
+                    head_col
+                } else {
+                    light
+                };
+                handle(screen(*p), fill, 4.0);
+            }
+            if self.state.drawing == Some(arrow.id)
+                && self.state.dragging.is_none()
+                && self.state.bending.is_none()
+                && let (Some(end), Some(h)) = (arrow.points.last(), self.state.hover)
+            {
+                draw.dashed(&[screen(*end), screen(h)], draw.dashes(), DataWidth::points(1.0), light);
+            }
+        }
+        if let Some(p) = self.state.pending {
+            handle(screen(p), start_col, 4.0);
+            if let Some(h) = self.state.hover {
+                draw.dashed(&[screen(p), screen(h)], draw.dashes(), DataWidth::points(1.0), light);
+            }
+        }
+    }
+
+    fn cursor(&self, cx: &ToolContext<'_>) -> Cursor {
+        let Some(at) = cx.pointer.as_ref().and_then(|p| doc_at(cx, p.pos)) else { return Cursor::System(CursorIcon::Crosshair) };
+        let reach = reach(cx);
+        let on_handle = self.scope.with_app(|app| {
+            let a = active_arrow(app)?;
+            let (_, i) = selected().filter(|(id, _)| *id == a.id)?;
+            hit_handle(&a, i, at, reach)
+        });
+        if on_handle.is_some() {
+            return Cursor::System(CursorIcon::Move);
+        }
+        let over = self.scope.with_app(|app| active_arrow(app).and_then(|a| hit_point(&a, at, reach)));
+        match over {
+            Some(_) if cx.mods.alt => Cursor::System(CursorIcon::NotAllowed),
+            Some(_) => Cursor::System(CursorIcon::Move),
+            None => Cursor::System(CursorIcon::Crosshair),
+        }
+    }
+
+    /// ⌘ is the Move tool's stand-in.
+    fn takes(&self, button: PointerButton, mods: Mods) -> bool {
+        button == PointerButton::Primary && !mods.cmd
+    }
+
+    fn autoscrolls(&self) -> bool {
+        self.state.dragging.is_some() || self.state.bending.is_some()
+    }
+
+    fn command_form(&self) -> ToolPath {
+        ToolPath::Command("the shape.create command with kind curveArrow")
+    }
+}
+
+// ------------------------------------------------------------------ the options bar
+
+const HEADS: [(u8, &str); 4] = [(geo::HEAD_TRIANGLE, "Triângulo"), (geo::HEAD_BARBED, "Farpa"), (geo::HEAD_OPEN, "Aberta (V)"), (geo::HEAD_NONE, "Nenhuma")];
+const TAILS: [(u8, &str); 3] = [(geo::TAIL_FLAT, "Reto"), (geo::TAIL_POINTED, "Pontudo"), (geo::TAIL_ARROW, "Duas pontas")];
+const LINES: [(u8, &str); 3] = [(0, "Sólida"), (1, "Tracejada"), (2, "Pontilhada")];
+const SECTIONS: [(u8, &str); 4] = [(0, "Ponta"), (1, "Início"), (2, "Linha"), (3, "Opacidade")];
+
+/// The line style a dash setting shows as: 0 solid, 1 dashed, 2 dotted.
+fn line_kind(o: &ArrowOptions) -> u8 {
+    if o.dash <= 0.0 {
+        0
+    } else if (o.dash - 1.0).abs() < 0.01 && o.dash_round >= 99.0 {
+        2
+    } else {
+        1
+    }
+}
+
+/// The Curved Arrow tool's options bar; false for another tool. The widths always show; a
+/// switch picks the head, the start or the line settings.
+pub fn options_bar(app: &mut PhotocraftApp, ui: &mut egui::Ui, tool: Tool) -> bool {
+    if tool != Tool::CurveArrow {
+        return false;
+    }
+    let arrow = active_arrow(app);
+    let mut o = options();
+    // An arrow's own values show while it is selected.
+    if let Some(a) = &arrow {
+        o.start_width = a.widths.first().copied().unwrap_or(20.0) as f32;
+        o.end_width = a.widths.last().copied().unwrap_or(40.0) as f32;
+        o.head = a.head;
+        o.head_length = a.head_length as f32;
+        o.head_width = a.head_width as f32;
+        o.tip_round = a.tip_round as f32;
+        o.barb_round = a.barb_round as f32;
+        o.tail = a.tail;
+        o.tail_round = a.tail_round as f32;
+        o.dash = a.dash as f32;
+        o.gap = a.gap as f32;
+        o.dash_round = a.dash_round as f32;
+        o.fade_start = a.fade_start as f32;
+        o.fade_end = a.fade_end as f32;
+    }
+    let before = o;
+    let sel = selected().filter(|(id, _)| arrow.as_ref().is_some_and(|a| a.id == *id));
+
+    // widths
+    let _ = option_cells::number(tl!("Início:"), &mut o.start_width, 0.5..=2000.0).unit("px").popup_slider().tooltip(tl!("Espessura no início da seta")).show(ui);
+    let _ = option_cells::number(tl!("Fim:"), &mut o.end_width, 0.5..=2000.0).unit("px").popup_slider().tooltip(tl!("Espessura perto da ponta")).show(ui);
+    let mut point_width = None;
+    if let (Some(a), Some((_, i))) = (&arrow, sel)
+        && let Some(w) = a.widths.get(i)
+    {
+        let mut v = *w as f32;
+        let shown = v;
+        let _ = option_cells::number(Label::from(format!("Ponto {}:", i + 1)), &mut v, 0.5..=2000.0)
+            .unit("px")
+            .popup_slider()
+            .tooltip(tl!("Espessura do ponto selecionado"))
+            .show(ui);
+        if (v - shown).abs() > f32::EPSILON {
+            point_width = Some((i, f64::from(v)));
+        }
+    }
+    let auto_curve = match (&arrow, sel) {
+        (Some(a), Some((_, i))) if a.custom(i) => Button::new(Label::from(tl!("Curva auto")))
+            .tooltip(tl!("Volta a curva deste ponto para a automática"))
+            .show(ui)
+            .clicked()
+            .then_some(i),
+        _ => None,
+    };
+    let flip = Button::new(Label::from(tl!("Inverter"))).enabled(arrow.is_some()).show(ui).clicked();
+    Divider::vertical().show(ui);
+
+    // which settings
+    let sections: Vec<Entry<u8>> = SECTIONS.iter().map(|(v, l)| Entry::new(*v, Label::from(*l))).collect();
+    let section = shared(|s| s.section);
+    if let Some(v) = Segmented::new(tl!("Ajustar"), Bind::given(section), &sections).show(ui).value().copied() {
+        shared(|s| s.section = v);
+    }
+    match shared(|s| s.section) {
+        1 => {
+            let tails: Vec<Entry<u8>> = TAILS.iter().map(|(v, l)| Entry::new(*v, Label::from(*l))).collect();
+            if let Some(v) = Select::new(tl!("Formato:"), Bind::given(o.tail), &tails).show(ui).events.committed().copied() {
+                o.tail = v;
+            }
+            let _ = option_cells::number(tl!("Arred.:"), &mut o.tail_round, 0.0..=100.0)
+                .whole()
+                .unit("%")
+                .popup_slider()
+                .tooltip(tl!("Arredondar o início (0 = quadrado, 100 = redondo)"))
+                .show(ui);
+        }
+        2 => {
+            let lines: Vec<Entry<u8>> = LINES.iter().map(|(v, l)| Entry::new(*v, Label::from(*l))).collect();
+            if let Some(v) = Select::new(tl!("Linha:"), Bind::given(line_kind(&o)), &lines).show(ui).events.committed().copied() {
+                match v {
+                    0 => o.dash = 0.0,
+                    2 => (o.dash, o.gap, o.dash_round) = (1.0, 1.0, 100.0),
+                    _ => (o.dash, o.gap, o.dash_round) = (2.0, 1.0, 0.0),
+                }
+            }
+            if o.dash > 0.0 {
+                let _ = option_cells::number(tl!("Traço:"), &mut o.dash, 0.1..=50.0)
+                    .unit("×")
+                    .popup_slider()
+                    .tooltip(tl!("Comprimento de cada traço, em espessuras da linha"))
+                    .show(ui);
+                let _ = option_cells::number(tl!("Espaço:"), &mut o.gap, 0.0..=50.0)
+                    .unit("×")
+                    .popup_slider()
+                    .tooltip(tl!("Espaço entre os traços, em espessuras da linha"))
+                    .show(ui);
+                let _ = option_cells::number(tl!("Arred.:"), &mut o.dash_round, 0.0..=100.0)
+                    .whole()
+                    .unit("%")
+                    .popup_slider()
+                    .tooltip(tl!("Arredondar as pontas dos traços (100 com traço 1× = bolinhas)"))
+                    .show(ui);
+            }
+        }
+        3 => {
+            let _ = option_cells::number(tl!("Opac. início:"), &mut o.fade_start, 0.0..=100.0)
+                .whole()
+                .unit("%")
+                .popup_slider()
+                .tooltip(tl!("Opacidade no começo da seta (degradê até a ponta)"))
+                .show(ui);
+            let _ = option_cells::number(tl!("Opac. ponta:"), &mut o.fade_end, 0.0..=100.0)
+                .whole()
+                .unit("%")
+                .popup_slider()
+                .tooltip(tl!("Opacidade na ponta da seta"))
+                .show(ui);
+        }
+        _ => {
+            let heads: Vec<Entry<u8>> = HEADS.iter().map(|(v, l)| Entry::new(*v, Label::from(*l))).collect();
+            if let Some(v) = Select::new(tl!("Formato:"), Bind::given(o.head), &heads).show(ui).events.committed().copied() {
+                o.head = v;
+            }
+            let _ = option_cells::number(tl!("Compr.:"), &mut o.head_length, 1.0..=4000.0).unit("px").popup_slider().tooltip(tl!("Comprimento da ponta")).show(ui);
+            let _ = option_cells::number(tl!("Larg.:"), &mut o.head_width, 1.0..=4000.0).unit("px").popup_slider().tooltip(tl!("Largura da ponta")).show(ui);
+            let _ = option_cells::number(tl!("Bico:"), &mut o.tip_round, 0.0..=100.0).whole().unit("%").popup_slider().tooltip(tl!("Arredondar o bico da ponta")).show(ui);
+            let _ = option_cells::number(tl!("Abas:"), &mut o.barb_round, 0.0..=100.0).whole().unit("%").popup_slider().tooltip(tl!("Arredondar as abas da ponta")).show(ui);
+        }
+    }
+
+    // what changed
+    set_options(o);
+    let Some(a) = arrow else {
+        option_cells::hint(ui, tl!("Clique os pontos na imagem · Enter termina"));
+        return true;
+    };
+    let mut patch = serde_json::Map::new();
+    if (o.start_width - before.start_width).abs() > f32::EPSILON || (o.end_width - before.end_width).abs() > f32::EPSILON {
+        patch.insert("widths".into(), json!(tapered(&a.points, &a.handles, f64::from(o.start_width), f64::from(o.end_width))));
+    }
+    if let Some((i, w)) = point_width {
+        let mut widths = a.widths.clone();
+        if let Some(slot) = widths.get_mut(i) {
+            *slot = w;
+        }
+        patch.insert("widths".into(), json!(widths));
+    }
+    let mut set = |key: &str, now: f32, was: f32| {
+        if (now - was).abs() > f32::EPSILON {
+            patch.insert(key.into(), json!(now));
+        }
+    };
+    set("headLength", o.head_length, before.head_length);
+    set("headWidth", o.head_width, before.head_width);
+    set("tipRound", o.tip_round, before.tip_round);
+    set("barbRound", o.barb_round, before.barb_round);
+    set("tailRound", o.tail_round, before.tail_round);
+    set("dash", o.dash, before.dash);
+    set("gap", o.gap, before.gap);
+    set("dashRound", o.dash_round, before.dash_round);
+    set("fadeStart", o.fade_start, before.fade_start);
+    set("fadeEnd", o.fade_end, before.fade_end);
+    if o.head != before.head {
+        patch.insert("head".into(), json!(o.head));
+    }
+    if o.tail != before.tail {
+        patch.insert("tail".into(), json!(o.tail));
+    }
+    if let Some(i) = auto_curve {
+        let mut handles = a.handle_list();
+        if let Some(slot) = handles.get_mut(i) {
+            *slot = None;
+        }
+        patch.insert("handles".into(), json!(handles));
+    }
+    if flip {
+        let points: Vec<[f64; 2]> = a.points.iter().rev().copied().collect();
+        // The widths stay in arrow order, so the start stays thin and the head end thick.
+        patch.insert("points".into(), json!(points));
+        // each point's handles swap sides
+        let handles: Vec<Option<[f64; 4]>> = a.handle_list().iter().rev().map(|h| h.map(|h| [h[2], h[3], h[0], h[1]])).collect();
+        patch.insert("handles".into(), json!(handles));
+        select(None);
+    }
+    if !patch.is_empty() {
+        let key = if flip || auto_curve.is_some() { None } else { Some(format!("curveArrow.bar.{}", a.id.0)) };
+        edit(app, a.id, Value::Object(patch), key.as_deref());
+    }
+    true
+}
