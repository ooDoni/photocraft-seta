diff --git a/crates/vector/src/along.rs b/crates/vector/src/along.rs
new file mode 100644
index 0000000..29ed83d
--- /dev/null
+++ b/crates/vector/src/along.rs
@@ -0,0 +1,234 @@
+//! Paint along a Curved Arrow: every pixel takes the colour and opacity at the nearest point of the
+//! arrow's centre line, so the arrow's own gradient (a colour per point, an opacity at each end)
+//! follows the curve however it bends.
+//!
+//! The position along the line (0 at the start, 1 at the tip) is found for the nodes of a coarse
+//! grid over the fill (nearest centre-line sample, propagated through the grid in two sweeps, then
+//! refined onto the line between samples) and interpolated between nodes for each pixel.
+
+use photocraft_color::Color;
+use photocraft_doc::vector::LiveShape;
+use photocraft_doc::{Fill, ShapeLayer};
+use photocraft_geom::Rect;
+
+use crate::Paint;
+use crate::curve_arrow::centre_samples;
+
+/// Grid nodes a field is computed for, at most (the spacing grows on big arrows).
+const MAX_NODES: f64 = 200_000.0;
+
+/// An arrow's colour along its centre line, with the line's position over a grid.
+#[derive(Clone, Debug, PartialEq)]
+pub struct AlongField {
+    x0: f64,
+    y0: f64,
+    /// Node spacing (px).
+    g: f64,
+    cols: usize,
+    rows: usize,
+    /// Position along the line (0..=1) at each node, row by row.
+    t: Vec<f32>,
+    /// Colour stops by position (straight RGBA, sorted).
+    stops: Vec<(f32, [f32; 4])>,
+    /// Opacity stops by position (empty = opaque).
+    opacity: Vec<(f32, f32)>,
+}
+
+impl AlongField {
+    /// Straight RGBA at pixel centre `(x, y)`.
+    pub fn at(&self, x: f64, y: f64) -> [f32; 4] {
+        crate::sample_stops(&self.stops, &[], &self.opacity, self.t_at(x, y))
+    }
+
+    /// Position along the line at `(x, y)`, between the grid's nodes.
+    fn t_at(&self, x: f64, y: f64) -> f32 {
+        let fx = ((x - self.x0) / self.g).clamp(0.0, (self.cols - 1) as f64);
+        let fy = ((y - self.y0) / self.g).clamp(0.0, (self.rows - 1) as f64);
+        let (i, j) = ((fx.floor() as usize).min(self.cols.saturating_sub(2)), (fy.floor() as usize).min(self.rows.saturating_sub(2)));
+        let (u, v) = ((fx - i as f64) as f32, (fy - j as f64) as f32);
+        let at = |i: usize, j: usize| self.t[(j.min(self.rows - 1)) * self.cols + i.min(self.cols - 1)];
+        let top = at(i, j) * (1.0 - u) + at(i + 1, j) * u;
+        let bottom = at(i, j + 1) * (1.0 - u) + at(i + 1, j + 1) * u;
+        (top * (1.0 - v) + bottom * v).clamp(0.0, 1.0)
+    }
+}
+
+fn rgba(c: &Color) -> [f32; 4] {
+    let v = c.to_rgb();
+    [v[0], v[1], v[2], c.alpha]
+}
+
+/// Whether a Curved Arrow is painted along its curve: a point has a colour or an end fades.
+pub fn paints_along(live: Option<&LiveShape>) -> bool {
+    matches!(live, Some(LiveShape::CurveArrow { colors, fade_start, fade_end, .. })
+        if colors.iter().any(Option::is_some) || *fade_start < 99.95 || *fade_end < 99.95)
+}
+
+/// The paint of a Curved Arrow painted along its curve, over `area` (the fill's pixel bounds):
+/// a point's colour at that point, an uncoloured start or tip in the fill's colour, uncoloured
+/// points between blending with their neighbours, the opacity going from the start's to the tip's.
+/// `None` for another shape, an arrow painted plainly, or a fill that is not a colour.
+pub fn arrow_paint(shape: &ShapeLayer, area: Rect) -> Option<Paint> {
+    if !paints_along(shape.live.as_ref()) {
+        return None;
+    }
+    let Some(LiveShape::CurveArrow { points, handles, colors, fade_start, fade_end, .. }) = &shape.live else { return None };
+    let Some(Fill::Solid(base)) = &shape.fill else { return None };
+    let (samples, at) = centre_samples(points, handles)?;
+    let n = points.len();
+    let mut stops: Vec<(f32, [f32; 4])> = Vec::with_capacity(n);
+    for (k, f) in at.iter().enumerate() {
+        match colors.get(k).copied().flatten() {
+            Some(c) => stops.push((*f as f32, rgba(&c))),
+            None if k == 0 || k + 1 == n => stops.push((*f as f32, rgba(base))),
+            None => {}
+        }
+    }
+    stops.sort_by(|a, b| a.0.total_cmp(&b.0));
+    let opacity = |v: f64| (v.clamp(0.0, 100.0) / 100.0) as f32;
+    let fades = *fade_start < 99.95 || *fade_end < 99.95;
+    let opacity = if fades { vec![(0.0, opacity(*fade_start)), (1.0, opacity(*fade_end))] } else { Vec::new() };
+    let t = field(&samples, area)?;
+    Some(Paint::Along(Box::new(AlongField { stops, opacity, ..t })))
+}
+
+/// The position along the line over `area`: the grid and its values (no colours yet).
+fn field(samples: &[[f64; 3]], area: Rect) -> Option<AlongField> {
+    let (w, h) = (f64::from(area.width()), f64::from(area.height()));
+    if samples.is_empty() || w < 1.0 || h < 1.0 {
+        return None;
+    }
+    let g = (w * h / MAX_NODES).sqrt().clamp(1.0, 16.0);
+    let (x0, y0) = (f64::from(area.x0) - g, f64::from(area.y0) - g);
+    let cols = ((w + 2.0 * g) / g).ceil() as usize + 1;
+    let rows = ((h + 2.0 * g) / g).ceil() as usize + 1;
+    let nodes = cols * rows;
+    let node = |i: usize, j: usize| (x0 + i as f64 * g, y0 + j as f64 * g);
+    let mut seed = vec![u32::MAX; nodes];
+    let mut d2 = vec![f64::INFINITY; nodes];
+    // each sample seeds the node nearest it (clamped onto the grid)
+    for (k, s) in samples.iter().enumerate() {
+        if !(s[0].is_finite() && s[1].is_finite()) {
+            continue;
+        }
+        let i = ((s[0] - x0) / g).round().clamp(0.0, (cols - 1) as f64) as usize;
+        let j = ((s[1] - y0) / g).round().clamp(0.0, (rows - 1) as f64) as usize;
+        let (nx, ny) = node(i, j);
+        let d = (s[0] - nx).powi(2) + (s[1] - ny).powi(2);
+        let idx = j * cols + i;
+        if d < d2[idx] {
+            d2[idx] = d;
+            seed[idx] = k as u32;
+        }
+    }
+    // the nearest seed spreads through the grid: two sweeps, each with a row pass back
+    let take = |seed: &mut [u32], d2: &mut [f64], i: usize, j: usize, from: usize| {
+        let s = seed[from];
+        if s == u32::MAX {
+            return;
+        }
+        let p = samples[s as usize];
+        let (nx, ny) = node(i, j);
+        let d = (p[0] - nx).powi(2) + (p[1] - ny).powi(2);
+        let idx = j * cols + i;
+        if d < d2[idx] {
+            d2[idx] = d;
+            seed[idx] = s;
+        }
+    };
+    for j in 0..rows {
+        for i in 0..cols {
+            if i > 0 {
+                take(&mut seed, &mut d2, i, j, j * cols + i - 1);
+            }
+            if j > 0 {
+                take(&mut seed, &mut d2, i, j, (j - 1) * cols + i);
+                if i > 0 {
+                    take(&mut seed, &mut d2, i, j, (j - 1) * cols + i - 1);
+                }
+                if i + 1 < cols {
+                    take(&mut seed, &mut d2, i, j, (j - 1) * cols + i + 1);
+                }
+            }
+        }
+        for i in (0..cols.saturating_sub(1)).rev() {
+            take(&mut seed, &mut d2, i, j, j * cols + i + 1);
+        }
+    }
+    for j in (0..rows).rev() {
+        for i in (0..cols).rev() {
+            if i + 1 < cols {
+                take(&mut seed, &mut d2, i, j, j * cols + i + 1);
+            }
+            if j + 1 < rows {
+                take(&mut seed, &mut d2, i, j, (j + 1) * cols + i);
+                if i + 1 < cols {
+                    take(&mut seed, &mut d2, i, j, (j + 1) * cols + i + 1);
+                }
+                if i > 0 {
+                    take(&mut seed, &mut d2, i, j, (j + 1) * cols + i - 1);
+                }
+            }
+        }
+        for i in 1..cols {
+            take(&mut seed, &mut d2, i, j, j * cols + i - 1);
+        }
+    }
+    // each node's position: projected onto the line on either side of its sample
+    let last = samples.len() - 1;
+    let mut t = vec![0.0f32; nodes];
+    for j in 0..rows {
+        for i in 0..cols {
+            let idx = j * cols + i;
+            let s = seed[idx];
+            if s == u32::MAX {
+                continue;
+            }
+            let s = s as usize;
+            let (nx, ny) = node(i, j);
+            let mut best = (d2[idx], samples[s][2]);
+            for (a, b) in [(s.saturating_sub(1), s), (s, (s + 1).min(last))] {
+                if a == b {
+                    continue;
+                }
+                let (pa, pb) = (samples[a], samples[b]);
+                let (dx, dy) = (pb[0] - pa[0], pb[1] - pa[1]);
+                let l2 = dx * dx + dy * dy;
+                if l2 < 1e-12 {
+                    continue;
+                }
+                let u = (((nx - pa[0]) * dx + (ny - pa[1]) * dy) / l2).clamp(0.0, 1.0);
+                let (qx, qy) = (pa[0] + dx * u, pa[1] + dy * u);
+                let d = (nx - qx).powi(2) + (ny - qy).powi(2);
+                if d < best.0 {
+                    best = (d, pa[2] + (pb[2] - pa[2]) * u);
+                }
+            }
+            t[idx] = best.1 as f32;
+        }
+    }
+    Some(AlongField { x0, y0, g, cols, rows, t, stops: Vec::new(), opacity: Vec::new() })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_position_follows_the_curve() {
+        // a U: start bottom left, up, over and down to the tip bottom right
+        let samples: Vec<[f64; 3]> = (0..=300)
+            .map(|k| {
+                let a = std::f64::consts::PI * f64::from(k) / 300.0;
+                [100.0 - 80.0 * a.cos(), 120.0 - 80.0 * a.sin(), f64::from(k) / 300.0]
+            })
+            .collect();
+        let f = field(&samples, Rect::new(0, 0, 200, 140)).unwrap();
+        // the two legs are close in a straight line but far apart along the curve
+        assert!(f.t_at(20.0, 118.0) < 0.05, "{}", f.t_at(20.0, 118.0));
+        assert!(f.t_at(180.0, 118.0) > 0.95, "{}", f.t_at(180.0, 118.0));
+        assert!((f.t_at(100.0, 40.0) - 0.5).abs() < 0.02, "{}", f.t_at(100.0, 40.0));
+        // off the line, a pixel takes the position of the nearest point on it
+        assert!((f.t_at(100.0, 30.0) - 0.5).abs() < 0.02);
+    }
+}
diff --git a/crates/vector/src/curve_arrow.rs b/crates/vector/src/curve_arrow.rs
new file mode 100644
index 0000000..ff9003a
--- /dev/null
+++ b/crates/vector/src/curve_arrow.rs
@@ -0,0 +1,1040 @@
+//! Curved arrow (the Arrow tool's live shape): a filled arrow along a smooth curve that passes
+//! through the clicked points, with a width per point, a head at the last point and a configurable
+//! start. The outline is built as overlapping closed polygons whose union is the arrow (every
+//! subpath combines), so a curve that crosses itself still fills solid.
+//!
+//! Head styles: [`HEAD_TRIANGLE`], [`HEAD_BARBED`], [`HEAD_OPEN`], [`HEAD_NONE`].
+//! Start styles: [`TAIL_FLAT`] (rounded by `tail_round`), [`TAIL_POINTED`], [`TAIL_ARROW`].
+
+use photocraft_doc::vector::{Path, PathOp, Subpath};
+
+pub const HEAD_TRIANGLE: u8 = 0;
+pub const HEAD_BARBED: u8 = 1;
+pub const HEAD_OPEN: u8 = 2;
+pub const HEAD_NONE: u8 = 3;
+pub const TAIL_FLAT: u8 = 0;
+pub const TAIL_POINTED: u8 = 1;
+pub const TAIL_ARROW: u8 = 2;
+
+/// Everything about the arrow but its points and widths.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ArrowStyle {
+    pub head: u8,
+    pub head_length: f64,
+    pub head_width: f64,
+    /// Rounding of the head's tip, 0..=100 %.
+    pub tip_round: f64,
+    /// Rounding of the head's barbs, 0..=100 %.
+    pub barb_round: f64,
+    pub tail: u8,
+    /// Rounding of a flat start (and of the end when there is no head), 0..=100 %; for a pointed
+    /// start, the rounding of its point.
+    pub tail_round: f64,
+    /// Dash length in multiples of the line's width there (0 = a solid line).
+    pub dash: f64,
+    /// Gap between dashes in multiples of the width.
+    pub gap: f64,
+    /// Rounding of the dashes' ends, 0..=100 % (100 with dash = width: round dots).
+    pub dash_round: f64,
+}
+
+type P = [f64; 2];
+
+/// A knot of the centre curve: anchor, incoming and outgoing control points.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Anchor {
+    pub a: P,
+    pub i: P,
+    pub o: P,
+}
+
+fn hyp(dx: f64, dy: f64) -> f64 {
+    dx.hypot(dy)
+}
+fn dist(a: P, b: P) -> f64 {
+    hyp(b[0] - a[0], b[1] - a[1])
+}
+
+/// The points without consecutive duplicates (a double click), with their widths.
+pub fn clean_points(points: &[P], widths: &[f64]) -> (Vec<P>, Vec<f64>) {
+    let mut ps: Vec<P> = Vec::with_capacity(points.len());
+    let mut ws: Vec<f64> = Vec::with_capacity(points.len());
+    for (k, p) in points.iter().enumerate() {
+        if !(p[0].is_finite() && p[1].is_finite()) {
+            continue;
+        }
+        let w = widths.get(k).or(widths.last()).copied().unwrap_or(10.0);
+        let w = if w.is_finite() { w.clamp(0.1, 100_000.0) } else { 10.0 };
+        if ps.last().is_some_and(|q| dist(*q, *p) < 0.5) {
+            continue;
+        }
+        ps.push(*p);
+        ws.push(w);
+    }
+    (ps, ws)
+}
+
+/// A smooth curve through `points`: tangents weighted by the chord lengths (no overshoot when the
+/// points are unevenly spaced), the end tangents continuing the neighbouring segment's bend.
+pub fn through_points(points: &[P]) -> Vec<Anchor> {
+    let n = points.len();
+    if n < 2 {
+        return points.iter().map(|p| Anchor { a: *p, i: *p, o: *p }).collect();
+    }
+    let d = |a: P, b: P| dist(a, b).max(1e-9);
+    let mut t = vec![[0.0_f64; 2]; n];
+    for k in 1..n - 1 {
+        let l = d(points[k - 1], points[k]) + d(points[k], points[k + 1]);
+        t[k] = [(points[k + 1][0] - points[k - 1][0]) / l, (points[k + 1][1] - points[k - 1][1]) / l];
+    }
+    if n == 2 {
+        let l = d(points[0], points[1]);
+        let u = [(points[1][0] - points[0][0]) / l, (points[1][1] - points[0][1]) / l];
+        t[0] = u;
+        t[1] = u;
+    } else {
+        let l0 = d(points[0], points[1]);
+        t[0] = [2.0 * (points[1][0] - points[0][0]) / l0 - t[1][0], 2.0 * (points[1][1] - points[0][1]) / l0 - t[1][1]];
+        let ln = d(points[n - 2], points[n - 1]);
+        t[n - 1] = [2.0 * (points[n - 1][0] - points[n - 2][0]) / ln - t[n - 2][0], 2.0 * (points[n - 1][1] - points[n - 2][1]) / ln - t[n - 2][1]];
+    }
+    let mut out: Vec<Anchor> = points.iter().map(|p| Anchor { a: *p, i: *p, o: *p }).collect();
+    for k in 0..n - 1 {
+        let l = d(points[k], points[k + 1]) / 3.0;
+        out[k].o = [points[k][0] + t[k][0] * l, points[k][1] + t[k][1] * l];
+        out[k + 1].i = [points[k + 1][0] - t[k + 1][0] * l, points[k + 1][1] - t[k + 1][1] * l];
+    }
+    out
+}
+
+/// The knots of the centre curve: smooth through `points`, with the handles a point has of its
+/// own (`[in x, in y, out x, out y]` offsets from it) in place of the automatic ones.
+pub fn anchors(points: &[P], handles: &[Option<[f64; 4]>]) -> Vec<Anchor> {
+    let mut out = through_points(points);
+    for (a, h) in out.iter_mut().zip(handles) {
+        if let Some(h) = h
+            && h.iter().all(|v| v.is_finite())
+        {
+            a.i = [a.a[0] + h[0], a.a[1] + h[1]];
+            a.o = [a.a[0] + h[2], a.a[1] + h[3]];
+        }
+    }
+    out
+}
+
+/// The cubic segments of the centre curve (for drawing the guide).
+pub fn guide_segments(points: &[P], handles: &[Option<[f64; 4]>]) -> Vec<[P; 4]> {
+    let an = anchors(points, handles);
+    an.windows(2).map(|w| [w[0].a, w[0].o, w[1].i, w[1].a]).collect()
+}
+
+fn bez(p0: P, p1: P, p2: P, p3: P, t: f64) -> P {
+    let mt = 1.0 - t;
+    let (a, b, c, d) = (mt * mt * mt, 3.0 * mt * mt * t, 3.0 * mt * t * t, t * t * t);
+    [a * p0[0] + b * p1[0] + c * p2[0] + d * p3[0], a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1]]
+}
+
+// ---------------------------------------------------------------- the centre curve by arc length
+
+struct Curve {
+    xs: Vec<f64>,
+    ys: Vec<f64>,
+    ss: Vec<f64>,
+    anchor_s: Vec<f64>,
+    widths: Vec<f64>,
+    length: f64,
+}
+
+impl Curve {
+    fn new(anchors: &[Anchor], widths: &[f64]) -> Curve {
+        let mut c = Curve { xs: vec![anchors[0].a[0]], ys: vec![anchors[0].a[1]], ss: vec![0.0], anchor_s: vec![0.0], widths: widths.to_vec(), length: 0.0 };
+        let mut s = 0.0;
+        for w in anchors.windows(2) {
+            let (p0, p1, p2, p3) = (w[0].a, w[0].o, w[1].i, w[1].a);
+            let est = dist(p0, p1) + dist(p1, p2) + dist(p2, p3);
+            let n = ((est / 1.5).ceil() as usize).clamp(4, 4000);
+            let (mut px, mut py) = (p0[0], p0[1]);
+            for k in 1..=n {
+                let q = bez(p0, p1, p2, p3, k as f64 / n as f64);
+                let d = hyp(q[0] - px, q[1] - py);
+                if d < 1e-6 {
+                    continue;
+                }
+                s += d;
+                c.xs.push(q[0]);
+                c.ys.push(q[1]);
+                c.ss.push(s);
+                px = q[0];
+                py = q[1];
+            }
+            c.anchor_s.push(s);
+        }
+        c.length = s;
+        c
+    }
+
+    fn find(&self, s: f64) -> usize {
+        let (mut lo, mut hi) = (0usize, self.ss.len() - 1);
+        while hi - lo > 1 {
+            let mid = (lo + hi) / 2;
+            if self.ss[mid] <= s {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        lo
+    }
+
+    fn point_at(&self, s: f64) -> P {
+        let n = self.ss.len();
+        if n < 2 || s <= 0.0 {
+            return [self.xs[0], self.ys[0]];
+        }
+        if s >= self.length {
+            return [self.xs[n - 1], self.ys[n - 1]];
+        }
+        let i = self.find(s);
+        let (s0, s1) = (self.ss[i], self.ss[i + 1]);
+        let f = if s1 - s0 > 1e-9 { (s - s0) / (s1 - s0) } else { 0.0 };
+        [self.xs[i] + (self.xs[i + 1] - self.xs[i]) * f, self.ys[i] + (self.ys[i + 1] - self.ys[i]) * f]
+    }
+
+    fn tangent_at(&self, s: f64) -> P {
+        let mut h = 1.5;
+        for _ in 0..6 {
+            let a = self.point_at((s - h).max(0.0));
+            let b = self.point_at((s + h).min(self.length));
+            let (dx, dy) = (b[0] - a[0], b[1] - a[1]);
+            let l = hyp(dx, dy);
+            if l > 1e-6 {
+                return [dx / l, dy / l];
+            }
+            h *= 3.0;
+        }
+        [1.0, 0.0]
+    }
+
+    fn width_at(&self, s: f64) -> f64 {
+        let (w, a) = (&self.widths, &self.anchor_s);
+        let n = a.len();
+        if s <= 0.0 {
+            return w[0];
+        }
+        if s >= self.length {
+            return w[n - 1];
+        }
+        for j in 0..n - 1 {
+            if s <= a[j + 1] {
+                let l = a[j + 1] - a[j];
+                let f = if l > 1e-9 { (s - a[j]) / l } else { 1.0 };
+                return w[j] + (w[j + 1] - w[j]) * f;
+            }
+        }
+        w[n - 1]
+    }
+}
+
+// ---------------------------------------------------------------- polygon helpers
+
+/// Twice the signed area of a closed polygon.
+fn area2(p: &[P]) -> f64 {
+    let n = p.len();
+    (0..n).map(|k| {
+        let (a, b) = (p[k], p[(k + 1) % n]);
+        a[0] * b[1] - b[0] * a[1]
+    })
+    .sum()
+}
+
+/// The polygon turning the positive way, so every piece of the arrow adds to the same fill and
+/// overlaps never cancel out.
+fn positive(mut p: Vec<P>) -> Vec<P> {
+    if area2(&p) < 0.0 {
+        p.reverse();
+    }
+    p
+}
+
+/// The convex hull of a few points (positive turning).
+fn hull(mut pts: Vec<P>) -> Vec<P> {
+    pts.retain(|q| q[0].is_finite() && q[1].is_finite());
+    pts.sort_by(|a, b| a[0].total_cmp(&b[0]).then(a[1].total_cmp(&b[1])));
+    pts.dedup_by(|a, b| dist(*a, *b) < 1e-9);
+    if pts.len() < 3 {
+        return pts;
+    }
+    let cross = |o: P, a: P, b: P| (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
+    let mut lower: Vec<P> = Vec::with_capacity(pts.len());
+    for q in &pts {
+        while lower.len() >= 2 && cross(lower[lower.len() - 2], lower[lower.len() - 1], *q) <= 0.0 {
+            lower.pop();
+        }
+        lower.push(*q);
+    }
+    let mut upper: Vec<P> = Vec::with_capacity(pts.len());
+    for q in pts.iter().rev() {
+        while upper.len() >= 2 && cross(upper[upper.len() - 2], upper[upper.len() - 1], *q) <= 0.0 {
+            upper.pop();
+        }
+        upper.push(*q);
+    }
+    lower.pop();
+    upper.pop();
+    lower.extend(upper);
+    lower
+}
+
+/// A cross-section of the line: centre, unit tangent, half width.
+type Section = (P, P, f64);
+
+fn sides(c: &Section) -> (P, P) {
+    let (p, tg, hw) = *c;
+    ([p[0] - tg[1] * hw, p[1] + tg[0] * hw], [p[0] + tg[1] * hw, p[1] - tg[0] * hw])
+}
+
+/// The cross-sections from `s0` to `s1`, about `step` apart and closer where the line bends, so
+/// the outside of a tight bend stays smooth however thick the line is.
+fn sections(s0: f64, s1: f64, step: f64, sample: &dyn Fn(f64) -> Section) -> Vec<Section> {
+    let n = (((s1 - s0) / step).ceil() as usize).clamp(1, 20_000);
+    let mut out = vec![sample(s0)];
+    let mut prev = s0;
+    for k in 1..=n {
+        let s = s0 + (s1 - s0) * k as f64 / n as f64;
+        let next = sample(s);
+        let (la, ra) = sides(out.last().unwrap_or(&next));
+        let (lb, rb) = sides(&next);
+        let d = dist(la, lb).max(dist(ra, rb));
+        let m = ((d / 4.0).ceil() as usize).clamp(1, 32);
+        for j in 1..m {
+            out.push(sample(prev + (s - prev) * j as f64 / m as f64));
+        }
+        out.push(next);
+        prev = s;
+    }
+    out
+}
+
+fn seg_x(a: P, b: P, c: P, d: P) -> bool {
+    let (rx, ry) = (b[0] - a[0], b[1] - a[1]);
+    let (sx, sy) = (d[0] - c[0], d[1] - c[1]);
+    let den = rx * sy - ry * sx;
+    if den.abs() < 1e-12 {
+        return false;
+    }
+    let (qx, qy) = (c[0] - a[0], c[1] - a[1]);
+    let t = (qx * sy - qy * sx) / den;
+    let u = (qx * ry - qy * rx) / den;
+    t > 0.0 && t < 1.0 && u > 0.0 && u < 1.0
+}
+
+/// The band a cross-section sweeps through `secs`. Where both sides move on, strips of up to
+/// `chunk` steps (overlapping, so a line that crosses itself stays solid); where a bend is tighter
+/// than the half width and the inner side would fold back over itself (leaving a hole), one
+/// convex piece per step, whose union stays filled.
+fn band(secs: &[Section], chunk: usize) -> Vec<Vec<P>> {
+    let n = secs.len();
+    let mut out = Vec::new();
+    if n < 2 {
+        return out;
+    }
+    let regular = |k: usize| {
+        let (a, b) = sides(&secs[k]);
+        let (c, d) = sides(&secs[k + 1]);
+        let t = [secs[k].1[0] + secs[k + 1].1[0], secs[k].1[1] + secs[k + 1].1[1]];
+        let on = |p: P, q: P| (q[0] - p[0]) * t[0] + (q[1] - p[1]) * t[1] > 0.0;
+        on(a, c) && on(b, d) && !seg_x(a, b, c, d)
+    };
+    let strip = |a: usize, b: usize| -> Vec<P> {
+        let mut p: Vec<P> = (a..=b).map(|k| sides(&secs[k]).0).collect();
+        p.extend((a..=b).rev().map(|k| sides(&secs[k]).1));
+        p
+    };
+    let mut run: Option<usize> = None;
+    for k in 0..n - 1 {
+        if regular(k) {
+            let a = *run.get_or_insert(k);
+            if k + 1 - a >= chunk.max(2) {
+                out.push(strip(a, k + 1));
+                run = Some(k);
+            }
+        } else {
+            if let Some(a) = run.take()
+                && k > a
+            {
+                out.push(strip(a, k));
+            }
+            let (a, b) = sides(&secs[k]);
+            let (c, d) = sides(&secs[k + 1]);
+            let h = hull(vec![a, b, c, d]);
+            if h.len() >= 3 {
+                out.push(h);
+            }
+        }
+    }
+    if let Some(a) = run
+        && n - 1 > a
+    {
+        out.push(strip(a, n - 1));
+    }
+    out
+}
+
+/// Rounds the vertices of a closed polygon: `r[k]` is the radius at vertex `k` (0 = sharp), `lim`
+/// an optional bound on how far along its edges a rounding may reach. An edge is shared half and
+/// half when both its ends are rounded.
+fn round_poly(p: &[P], r: &[f64], lim: Option<&[f64]>) -> Vec<P> {
+    let n = p.len();
+    let mut out = Vec::with_capacity(n * 4);
+    for k in 0..n {
+        let mut rad = r.get(k).copied().unwrap_or(0.0);
+        let v = p[k];
+        if rad <= 0.05 {
+            out.push(v);
+            continue;
+        }
+        let (a, b) = (p[(k + n - 1) % n], p[(k + 1) % n]);
+        let (mut ax, mut ay) = (a[0] - v[0], a[1] - v[1]);
+        let (mut bx, mut by) = (b[0] - v[0], b[1] - v[1]);
+        let (la, lb) = (hyp(ax, ay), hyp(bx, by));
+        if la < 1e-6 || lb < 1e-6 {
+            out.push(v);
+            continue;
+        }
+        ax /= la;
+        ay /= la;
+        bx /= lb;
+        by /= lb;
+        let th = (ax * bx + ay * by).clamp(-1.0, 1.0).acos();
+        if !(1e-3..std::f64::consts::PI - 1e-3).contains(&th) {
+            out.push(v);
+            continue;
+        }
+        let tan_h = (th / 2.0).tan();
+        let mut d = rad / tan_h;
+        let fa = if r.get((k + n - 1) % n).copied().unwrap_or(0.0) > 0.05 { 0.5 } else { 0.97 };
+        let fb = if r.get((k + 1) % n).copied().unwrap_or(0.0) > 0.05 { 0.5 } else { 0.97 };
+        let mut d_max = (fa * la).min(fb * lb);
+        if let Some(l) = lim.and_then(|l| l.get(k)) {
+            d_max = d_max.min(*l);
+        }
+        if d_max <= 0.05 {
+            out.push(v);
+            continue;
+        }
+        if d > d_max {
+            d = d_max;
+            rad = d * tan_h;
+        }
+        let t1 = [v[0] + ax * d, v[1] + ay * d];
+        let t2 = [v[0] + bx * d, v[1] + by * d];
+        let (mut mx, mut my) = (ax + bx, ay + by);
+        let lm = hyp(mx, my);
+        mx /= lm;
+        my /= lm;
+        let dc = rad / (th / 2.0).sin();
+        let c = [v[0] + mx * dc, v[1] + my * dc];
+        let a1 = (t1[1] - c[1]).atan2(t1[0] - c[0]);
+        let a2 = (t2[1] - c[1]).atan2(t2[0] - c[0]);
+        let mut da = a2 - a1;
+        while da > std::f64::consts::PI {
+            da -= 2.0 * std::f64::consts::PI;
+        }
+        while da < -std::f64::consts::PI {
+            da += 2.0 * std::f64::consts::PI;
+        }
+        let steps = ((da.abs() * rad / 1.5).ceil() as usize).clamp(2, 20);
+        for s in 0..=steps {
+            let ang = a1 + da * s as f64 / steps as f64;
+            out.push([c[0] + rad * ang.cos(), c[1] + rad * ang.sin()]);
+        }
+    }
+    out
+}
+
+/// How far the rounding of a barb may reach along its edges before it would uncover the body.
+fn barb_limit(loc: &[P], k: usize, hw_j: f64, body_x: f64) -> f64 {
+    let n = loc.len();
+    let v = loc[k];
+    let sv = if v[1] >= 0.0 { 1.0 } else { -1.0 };
+    let yv = v[1].abs();
+    if yv <= hw_j {
+        return 1e9;
+    }
+    let mut best = 1e9_f64;
+    for nb in [loc[(k + n - 1) % n], loc[(k + 1) % n]] {
+        let yn = nb[1] * sv;
+        if yn >= hw_j {
+            continue;
+        }
+        let f = (yv - hw_j) / (yv - yn);
+        let xc = v[0] + f * (nb[0] - v[0]);
+        if xc > body_x + 0.5 {
+            continue;
+        }
+        best = best.min(f * dist(v, nb) * 0.92);
+    }
+    best
+}
+
+fn dedupe(p: Vec<P>) -> Vec<P> {
+    let mut out: Vec<P> = Vec::with_capacity(p.len());
+    for q in p {
+        if out.last().is_some_and(|l| dist(*l, q) < 0.05) {
+            continue;
+        }
+        out.push(q);
+    }
+    while out.len() > 2 && dist(out[0], out[out.len() - 1]) < 0.05 {
+        out.pop();
+    }
+    out
+}
+
+// ---------------------------------------------------------------- head and caps
+
+struct Head {
+    poly: Vec<P>,
+    body_s: f64,
+    base: P,
+    d: P,
+    s_base: f64,
+    k: f64,
+    len: f64,
+    neck: Option<f64>,
+}
+
+/// The head at the end (`dir` +1) or at the start (`dir` -1) of the curve, `len` long along it.
+fn make_head(cv: &Curve, len: f64, style: &ArrowStyle, dir: f64) -> Head {
+    let s_tip = if dir > 0.0 { cv.length } else { 0.0 };
+    let s_base = s_tip - dir * len;
+    let tip = cv.point_at(s_tip);
+    let base = cv.point_at(s_base);
+    let (dx, dy) = (tip[0] - base[0], tip[1] - base[1]);
+    let mut chord = hyp(dx, dy);
+    let d = if chord < 1e-6 {
+        let tg = cv.tangent_at(s_tip);
+        chord = len;
+        [tg[0] * dir, tg[1] * dir]
+    } else {
+        [dx / chord, dy / chord]
+    };
+    let lr = chord;
+    let nrm = [-d[1], d[0]];
+    let hw = (style.head_width / 2.0).max(1.0);
+    let hw_j = (cv.width_at(s_base) / 2.0).max(0.5);
+    let mut neck = None;
+    let (mut loc, roles, body_x): (Vec<P>, Vec<u8>, f64) = match style.head {
+        HEAD_BARBED => {
+            let (back, notch) = (0.3 * lr, 0.12 * lr);
+            (vec![[-back, hw], [lr, 0.0], [-back, -hw], [notch, 0.0]], vec![2, 1, 2, 0], notch + 0.1 * lr)
+        }
+        HEAD_OPEN => {
+            let h = hyp(lr, hw);
+            let sin_a = hw / h;
+            let mut t = (2.0 * hw_j).min(0.3 * h).max(2.0);
+            if lr - t / sin_a < 0.1 * lr {
+                t = 0.9 * lr * sin_a;
+            }
+            neck = Some(t / 2.0);
+            let (ux, uy) = (-lr / h, hw / h);
+            let (inx, iny) = (-uy, ux);
+            let inner_tip = lr - t / sin_a;
+            let p2 = [0.0, hw];
+            let p3 = [p2[0] + inx * t, p2[1] + iny * t];
+            (vec![[lr, 0.0], p2, p3, [inner_tip, 0.0], [p3[0], -p3[1]], [0.0, -hw]], vec![1, 2, 2, 0, 2, 2], inner_tip + 0.35 * (lr - inner_tip))
+        }
+        _ => {
+            let bx = if hw > hw_j { (0.25 * lr).min(lr * (1.0 - hw_j / hw) * 0.7) } else { 0.5 };
+            (vec![[0.0, hw], [lr, 0.0], [0.0, -hw]], vec![2, 1, 2], bx.max(0.5))
+        }
+    };
+    let r_max = 0.5 * lr.min(hw);
+    let r_tip = style.tip_round.clamp(0.0, 100.0) / 100.0 * r_max;
+    let r_barb = style.barb_round.clamp(0.0, 100.0) / 100.0 * r_max;
+    if r_tip > 0.05 || r_barb > 0.05 {
+        let mut radii = Vec::with_capacity(loc.len());
+        let mut lims = Vec::with_capacity(loc.len());
+        for (k, role) in roles.iter().enumerate() {
+            match role {
+                1 => {
+                    radii.push(r_tip);
+                    lims.push(1e9);
+                }
+                2 => {
+                    radii.push(r_barb);
+                    lims.push(if style.head == HEAD_OPEN { 1e9 } else { barb_limit(&loc, k, hw_j, body_x) });
+                }
+                _ => {
+                    radii.push(0.0);
+                    lims.push(1e9);
+                }
+            }
+        }
+        loc = round_poly(&loc, &radii, Some(&lims));
+    }
+    let poly = loc.iter().map(|q| [base[0] + d[0] * q[0] + nrm[0] * q[1], base[1] + d[1] * q[0] + nrm[1] * q[1]]).collect();
+    let body_s = s_base + dir * body_x * (len / lr);
+    Head { poly, body_s, base, d, s_base, k: lr / len, len, neck }
+}
+
+/// A flat end with corners rounded by `r`, at the start (`dir` +1) or the end (`dir` -1). The body
+/// starts (or ends) `r` in from the end, and the cap is built in the frame of that point, so it
+/// fits without a step even on a bend.
+fn make_cap(cv: &Curve, dir: f64, r: f64, step: f64) -> Option<(Vec<P>, f64)> {
+    let s_len = cv.length;
+    if r <= 0.3 {
+        return None;
+    }
+    let r = r.min(s_len * 0.3);
+    let s_edge = if dir > 0.0 { 0.0 } else { s_len };
+    let s_b = s_edge + dir * r;
+    let p = cv.point_at(s_b);
+    let tg = cv.tangent_at(s_b);
+    let t = [tg[0] * dir, tg[1] * dir];
+    let n = [-t[1], t[0]];
+    let hw_e = (cv.width_at(s_edge) / 2.0).max(0.25);
+    let hw_b = (cv.width_at(s_b) / 2.0).max(0.25);
+    let ov = step.max(1.0);
+    let loc = [[-r, hw_e], [ov, hw_b], [ov, -hw_b], [-r, -hw_e]];
+    let loc = round_poly(&loc, &[r, 0.0, 0.0, r], None);
+    let poly = loc.iter().map(|q| [p[0] + t[0] * q[0] + n[0] * q[1], p[1] + t[1] * q[0] + n[1] * q[1]]).collect();
+    Some((poly, s_b))
+}
+
+// ---------------------------------------------------------------- dashes
+
+/// The end of a dash at `p` facing `d` (unit), its sides along `m` (unit, the side the outline
+/// arrives from) at half width `hw`, corners rounded by `r`: points from `p + m·hw` around the end
+/// to `p - m·hw`.
+fn round_end(p: P, d: P, m: P, hw: f64, r: f64) -> Vec<P> {
+    let r = r.clamp(0.0, hw);
+    if r <= 0.05 {
+        return vec![[p[0] + m[0] * hw, p[1] + m[1] * hw], [p[0] - m[0] * hw, p[1] - m[1] * hw]];
+    }
+    let steps = ((r * std::f64::consts::FRAC_PI_2 / 1.5).ceil() as usize).clamp(2, 24);
+    let mut out = Vec::with_capacity(2 * steps + 2);
+    for (side, from, to) in [(1.0, 0.0, std::f64::consts::FRAC_PI_2), (-1.0, std::f64::consts::FRAC_PI_2, std::f64::consts::PI)] {
+        let c = [p[0] + side * m[0] * (hw - r), p[1] + side * m[1] * (hw - r)];
+        for k in 0..=steps {
+            let th = from + (to - from) * k as f64 / steps as f64;
+            out.push([c[0] + m[0] * r * th.cos() + d[0] * r * th.sin(), c[1] + m[1] * r * th.cos() + d[1] * r * th.sin()]);
+        }
+    }
+    out
+}
+
+/// The dashes between `s0` and `s1` (arc length): each `dash` widths long, `gap` widths apart (the
+/// width where it starts), the gaps stretched so the last dash ends at `s1`.
+fn dash_intervals(s0: f64, s1: f64, dash: f64, gap: f64, width: &dyn Fn(f64) -> f64) -> Vec<(f64, f64)> {
+    const MAX: usize = 4000;
+    let len = |s: f64, k: f64| (k * width(s)).max(0.5);
+    // how many whole dashes fit with the plain gaps
+    let mut n = 0usize;
+    let mut s = s0;
+    while n < MAX {
+        let d = len(s, dash);
+        if s + d > s1 + 1e-9 {
+            break;
+        }
+        n += 1;
+        s += d + len(s + d, gap.max(0.0)) * if gap > 0.0 { 1.0 } else { 0.0 };
+    }
+    if n == 0 {
+        return vec![(s0, s1)];
+    }
+    let lay = |f: f64| -> Vec<(f64, f64)> {
+        let mut out = Vec::with_capacity(n);
+        let mut s = s0;
+        for i in 0..n {
+            let d = len(s, dash);
+            out.push((s, s + d));
+            if i + 1 < n {
+                s += d + if gap > 0.0 { len(s + d, gap) * f } else { 0.0 };
+            }
+        }
+        out
+    };
+    if n == 1 || gap <= 0.0 {
+        return lay(1.0);
+    }
+    // stretch the gaps: the end of the last dash grows with `f`
+    let end = |f: f64| lay(f).last().map_or(s0, |l| l.1);
+    let (mut lo, mut hi) = (1.0_f64, 2.0_f64);
+    while end(hi) < s1 && hi < 1.0e6 {
+        hi *= 2.0;
+    }
+    for _ in 0..40 {
+        let mid = (lo + hi) / 2.0;
+        if end(mid) < s1 {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    let mut out = lay(lo);
+    if let Some(last) = out.last_mut() {
+        last.1 = last.1.min(s1);
+    }
+    out
+}
+
+// ---------------------------------------------------------------- the arrow
+
+/// The arrow's outline as closed polygons (their union is the arrow), for a centre curve given as
+/// knots with explicit control points.
+pub fn arrow_polygons(anchors: &[Anchor], widths: &[f64], style: &ArrowStyle) -> Vec<Vec<P>> {
+    if anchors.len() < 2 || widths.len() != anchors.len() {
+        return Vec::new();
+    }
+    let cv = Curve::new(anchors, widths);
+    let s_len = cv.length;
+    if !(s_len >= 4.0 && s_len.is_finite()) {
+        return Vec::new();
+    }
+    let max_w = widths.iter().copied().fold(1.0_f64, f64::max);
+    let step = (max_w / 6.0).clamp(1.5, 6.0);
+    // strip length (in steps) of the body's overlapping pieces
+    let chunk = ((1.4 * max_w / step).round() as usize).max(4);
+    let tail_round = style.tail_round.clamp(0.0, 100.0) / 100.0;
+    let dashed = style.dash.is_finite() && style.dash > 0.0;
+
+    let mut polys: Vec<Vec<P>> = Vec::new();
+    let has_head = style.head != HEAD_NONE;
+    let tail_head = style.tail == TAIL_ARROW;
+    let mut lh = if has_head { style.head_length.max(1.0).min(s_len * 0.6) } else { 0.0 };
+    let mut lt = if tail_head { style.head_length.max(1.0).min(s_len * 0.6) } else { 0.0 };
+    if has_head && tail_head && lh + lt > s_len * 0.9 {
+        let f = s_len * 0.9 / (lh + lt);
+        lh *= f;
+        lt *= f;
+    }
+
+    let (mut s_start, mut s_end) = (0.0, s_len);
+    let mut h = None;
+    let mut th = None;
+    if has_head {
+        let head = make_head(&cv, lh, style, 1.0);
+        polys.push(head.poly.clone());
+        s_end = s_len.min(head.body_s);
+        h = Some(head);
+    } else if !dashed && let Some((poly, s)) = make_cap(&cv, -1.0, tail_round * cv.width_at(s_len) / 2.0, step) {
+        polys.push(poly);
+        s_end = s;
+    }
+    if tail_head {
+        let head = make_head(&cv, lt, style, -1.0);
+        polys.push(head.poly.clone());
+        s_start = head.body_s.max(0.0);
+        th = Some(head);
+    } else if style.tail == TAIL_FLAT
+        && !dashed
+        && let Some((poly, s)) = make_cap(&cv, 1.0, tail_round * cv.width_at(0.0) / 2.0, step)
+    {
+        polys.push(poly);
+        s_start = s;
+    }
+    if s_end - s_start < 1.0 {
+        return polys;
+    }
+
+    // a point of the body: inside a head it runs straight along the head, and an open head's
+    // line thins to its arms' thickness
+    let sample = |s: f64| -> (P, P, f64) {
+        let (p, tg) = match (&h, &th) {
+            (Some(h), _) if s > h.s_base => {
+                ([h.base[0] + h.d[0] * (s - h.s_base) * h.k, h.base[1] + h.d[1] * (s - h.s_base) * h.k], h.d)
+            }
+            (_, Some(t)) if s < t.s_base => {
+                ([t.base[0] + t.d[0] * (t.s_base - s) * t.k, t.base[1] + t.d[1] * (t.s_base - s) * t.k], [-t.d[0], -t.d[1]])
+            }
+            _ => (cv.point_at(s), cv.tangent_at(s)),
+        };
+        let mut hw = (cv.width_at(s) / 2.0).max(0.25);
+        if let Some(h) = &h
+            && let Some(neck) = h.neck
+            && hw > neck
+        {
+            hw = neck + (hw - neck) * ((h.s_base - s) / (0.6 * h.len)).clamp(0.0, 1.0);
+        }
+        if let Some(t) = &th
+            && let Some(neck) = t.neck
+            && hw > neck
+        {
+            hw = neck + (hw - neck) * ((s - t.s_base) / (0.6 * t.len)).clamp(0.0, 1.0);
+        }
+        (p, tg, hw)
+    };
+
+    if dashed {
+        let round = style.dash_round.clamp(0.0, 100.0) / 100.0;
+        let width = |s: f64| 2.0 * sample(s).2;
+        // the pattern stops one gap before a head's back, so no dash bulges out behind it
+        let gap = style.gap.max(0.0);
+        let (mut d0, mut d1) = (s_start, s_end);
+        if let Some(h) = &h {
+            d1 = d1.min(h.s_base - gap * cv.width_at(h.s_base.clamp(0.0, s_len)));
+        }
+        if let Some(t) = &th {
+            d0 = d0.max(t.s_base + gap * cv.width_at(t.s_base.clamp(0.0, s_len)));
+        }
+        if d1 - d0 < 1.0 {
+            return polys;
+        }
+        for (a, b) in dash_intervals(d0, d1, style.dash, gap, &width) {
+            let half = (b - a) / 2.0;
+            let (ha, hb) = (sample(a).2, sample(b).2);
+            let (ra, rb) = ((round * ha).min(half), (round * hb).min(half));
+            let (a2, b2) = (a + ra, (b - rb).max(a + ra));
+            let secs = sections(a2, b2, step, &sample);
+            polys.extend(band(&secs, chunk));
+            // the two ends, rounded
+            let (pb, tb, hwb) = sample(b2);
+            let (pa, ta, hwa) = sample(a2);
+            for end in [round_end(pb, tb, [-tb[1], tb[0]], hwb, rb), round_end(pa, [-ta[0], -ta[1]], [ta[1], -ta[0]], hwa, ra)] {
+                let end = dedupe(end);
+                if end.len() >= 3 && area2(&end).abs() > 1e-6 {
+                    polys.push(end);
+                }
+            }
+        }
+        return polys;
+    }
+
+    // the body: the band a cross-section sweeps from start to end
+    let secs = sections(s_start, s_end, step, &sample);
+    polys.extend(band(&secs, chunk));
+
+    // a pointed start, its point roundable
+    if style.tail == TAIL_POINTED
+        && let Some(&(p0, t0, h0)) = secs.first()
+    {
+        let ext = (h0 * 3.0).max(4.0);
+        let tip = [p0[0] - t0[0] * ext, p0[1] - t0[1] * ext];
+        let (l0, r0) = sides(&(p0, t0, h0));
+        // reaching a little into the body, so the two join without a seam
+        let q = sample((s_start + step).min(s_end));
+        let (l1, r1) = sides(&q);
+        let poly = vec![l1, l0, tip, r0, r1];
+        polys.push(round_poly(&poly, &[0.0, 0.0, tail_round * h0 * 0.55, 0.0, 0.0], None));
+    }
+    polys
+}
+
+/// The arrow through `points` (one width per point) as a path: closed corner subpaths that combine.
+pub fn curve_arrow(points: &[P], widths: &[f64], style: &ArrowStyle) -> Path {
+    curve_arrow_with(points, &[], widths, style)
+}
+
+/// The indices of the points `clean_points` keeps.
+fn kept_points(points: &[P]) -> Vec<usize> {
+    let mut kept: Vec<usize> = Vec::with_capacity(points.len());
+    for (k, p) in points.iter().enumerate() {
+        if !(p[0].is_finite() && p[1].is_finite()) {
+            continue;
+        }
+        if kept.last().is_some_and(|&j| dist(points[j], *p) < 0.5) {
+            continue;
+        }
+        kept.push(k);
+    }
+    kept
+}
+
+/// The centre curve sampled densely, each sample `[x, y, f]` with `f` its fraction of the way from
+/// the start (0) to the tip (1), and each point's fraction (a dropped duplicate point has its
+/// neighbour's). `None` for fewer than two distinct points.
+pub fn centre_samples(points: &[P], handles: &[Option<[f64; 4]>]) -> Option<(Vec<[f64; 3]>, Vec<f64>)> {
+    let kept = kept_points(points);
+    if kept.len() < 2 {
+        return None;
+    }
+    let ps: Vec<P> = kept.iter().map(|&k| points[k]).collect();
+    let hs: Vec<Option<[f64; 4]>> = kept.iter().map(|&k| handles.get(k).copied().flatten()).collect();
+    let cv = Curve::new(&anchors(&ps, &hs), &vec![1.0; ps.len()]);
+    if !(cv.length > 1e-6 && cv.length.is_finite()) {
+        return None;
+    }
+    let samples = cv.xs.iter().zip(&cv.ys).zip(&cv.ss).map(|((x, y), s)| [*x, *y, s / cv.length]).collect();
+    let mut at = vec![0.0; points.len()];
+    let mut j = 0;
+    for (k, f) in at.iter_mut().enumerate() {
+        while j + 1 < kept.len() && kept[j + 1] <= k {
+            j += 1;
+        }
+        *f = (cv.anchor_s[j] / cv.length).clamp(0.0, 1.0);
+    }
+    Some((samples, at))
+}
+
+/// [`curve_arrow`] with the handles points have of their own (see [`anchors`]).
+pub fn curve_arrow_with(points: &[P], handles: &[Option<[f64; 4]>], widths: &[f64], style: &ArrowStyle) -> Path {
+    // the points kept by `clean_points`, so the handles stay with their points
+    let kept = kept_points(points);
+    let (ps, ws) = clean_points(points, widths);
+    if ps.len() < 2 || ps.len() != kept.len() {
+        return Path::default();
+    }
+    let hs: Vec<Option<[f64; 4]>> = kept.iter().map(|&k| handles.get(k).copied().flatten()).collect();
+    let anchors = anchors(&ps, &hs);
+    let polys = arrow_polygons(&anchors, &ws, style);
+    let subpaths = polys
+        .into_iter()
+        .filter(|p| p.len() >= 3 && p.iter().all(|q| q[0].is_finite() && q[1].is_finite()))
+        .map(positive)
+        .map(|p| {
+            let pts: Vec<(f64, f64)> = p.iter().map(|q| (q[0], q[1])).collect();
+            Subpath::polygon(&pts).with_op(PathOp::Combine)
+        })
+        .collect();
+    let pieces = Path::new(subpaths);
+    merged(&pieces).unwrap_or(pieces)
+}
+
+/// The pieces as one outline (a curve that crosses itself keeps its hole-free overlap), so a
+/// vector stroke on the shape outlines the arrow and not every piece: the union is rendered at up
+/// to 4× and traced back to curves (as Merge Shape Components does). `None` when it can't be.
+fn merged(pieces: &Path) -> Option<Path> {
+    let (x0, y0, x1, y1) = pieces.control_bounds()?;
+    let area = ((x1 - x0) * (y1 - y0)).max(1.0);
+    // about 2.5 million samples at most: fine enough to trace, quick enough to drag a point
+    let k = (2.5e6 / area).sqrt().clamp(1.0, 4.0);
+    let up = pieces.transform(&photocraft_geom::Affine::scale(k));
+    let r = crate::fill_rasterizer(&up, crate::DEFAULT_TOLERANCE);
+    let b = r.pixel_bounds()?.inflate(2);
+    if u64::from(b.width()) * u64::from(b.height()) > 40_000_000 {
+        return None;
+    }
+    let cov = r.render(b);
+    let traced = crate::trace::trace_mask(&cov, b, 0.0, 0.25 * k);
+    (!traced.subpaths.is_empty()).then(|| traced.transform(&photocraft_geom::Affine::scale(1.0 / k)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn style() -> ArrowStyle {
+        ArrowStyle {
+            head: HEAD_TRIANGLE,
+            head_length: 42.0,
+            head_width: 62.0,
+            tip_round: 0.0,
+            barb_round: 0.0,
+            tail: TAIL_FLAT,
+            tail_round: 100.0,
+            dash: 0.0,
+            gap: 0.0,
+            dash_round: 0.0,
+        }
+    }
+
+    #[test]
+    fn three_points_make_a_head_and_a_body() {
+        let p = curve_arrow(&[[300.0, 212.0], [380.0, 30.0], [452.0, 118.0]], &[12.0, 18.0, 24.0], &style());
+        assert!(!p.subpaths.is_empty());
+        assert!(p.subpaths.iter().all(|s| s.closed && s.knots.len() >= 3));
+        let (x0, y0, x1, y1) = p.control_bounds().unwrap();
+        assert!(x0 < 300.0 && x1 > 452.0 && y0 < 30.0 && y1 > 212.0);
+    }
+
+    #[test]
+    fn the_curve_passes_through_every_point() {
+        let pts = [[0.0, 0.0], [100.0, 50.0], [180.0, -20.0], [300.0, 40.0]];
+        let segs = guide_segments(&pts, &[]);
+        assert_eq!(segs.len(), 3);
+        for (k, s) in segs.iter().enumerate() {
+            assert_eq!(s[0], pts[k]);
+            assert_eq!(s[3], pts[k + 1]);
+        }
+    }
+
+    #[test]
+    fn degenerate_input_gives_an_empty_path() {
+        assert!(curve_arrow(&[[5.0, 5.0]], &[10.0], &style()).subpaths.is_empty());
+        assert!(curve_arrow(&[[5.0, 5.0], [5.2, 5.1]], &[10.0, 10.0], &style()).subpaths.is_empty());
+        assert!(curve_arrow(&[[f64::NAN, 0.0], [10.0, 0.0]], &[10.0, 10.0], &style()).subpaths.is_empty());
+    }
+
+    /// The merged outline's pieces and the size of each.
+    fn outlines(p: &Path) -> Vec<(f64, f64)> {
+        p.subpaths
+            .iter()
+            .filter_map(|sp| {
+                let r = crate::fill_rasterizer(&Path::new(vec![sp.clone()]), crate::DEFAULT_TOLERANCE).pixel_bounds()?;
+                Some((f64::from(r.width()), f64::from(r.height())))
+            })
+            .collect()
+    }
+
+    #[test]
+    fn dashes_and_dots() {
+        let pts = [[10.0, 200.0], [150.0, 40.0], [300.0, 160.0]];
+        let w = [12.0, 12.0, 12.0];
+        let dashed = ArrowStyle { dash: 2.0, gap: 1.0, dash_round: 0.0, ..style() };
+        let dashes = outlines(&curve_arrow(&pts, &w, &dashed));
+        // about 420 px of body: dashes of 24 px with 12 px gaps, plus the head
+        assert!((9..=14).contains(&dashes.len()), "{} pieces", dashes.len());
+        let dots = ArrowStyle { dash: 1.0, gap: 1.0, dash_round: 100.0, ..style() };
+        let dots = outlines(&curve_arrow(&pts, &w, &dots));
+        // a dot is a circle of the line's width
+        let round = dots.iter().filter(|(w, h)| (w - 12.5).abs() < 1.6 && (h - 12.5).abs() < 1.6).count();
+        assert!(round + 2 >= dots.len() && round >= 8, "{dots:?}");
+        // the gaps are stretched so the last dash reaches the end
+        let iv = dash_intervals(0.0, 100.0, 2.0, 1.0, &|_| 10.0);
+        assert!((iv.last().map_or(0.0, |l| l.1) - 100.0).abs() < 1e-6);
+        assert_eq!(iv.len(), 3);
+    }
+
+    #[test]
+    fn handles_of_its_own_bend_the_curve() {
+        let pts = [[0.0, 0.0], [100.0, 0.0], [200.0, 0.0]];
+        let auto = anchors(&pts, &[]);
+        assert_eq!(auto[1].o[1], 0.0, "a straight line stays straight");
+        let bent = anchors(&pts, &[None, Some([-30.0, 20.0, 30.0, -20.0])]);
+        assert_eq!(bent[1].i, [70.0, 20.0]);
+        assert_eq!(bent[1].o, [130.0, -20.0]);
+        assert_eq!(bent[2].i, auto[2].i, "missing entries stay automatic");
+        let w = [10.0, 10.0, 10.0];
+        let st = ArrowStyle { head: HEAD_NONE, ..style() };
+        assert_ne!(curve_arrow_with(&pts, &[None, Some([-30.0, 20.0, 30.0, -20.0])], &w, &st), curve_arrow(&pts, &w, &st));
+        // a dropped duplicate point takes its handles with it
+        let dup = [[0.0, 0.0], [0.1, 0.0], [100.0, 0.0], [200.0, 0.0]];
+        assert_eq!(
+            curve_arrow_with(&dup, &[None, None, Some([-30.0, 20.0, 30.0, -20.0])], &[10.0; 4], &st),
+            curve_arrow_with(&pts, &[None, Some([-30.0, 20.0, 30.0, -20.0])], &w, &st)
+        );
+    }
+
+    #[test]
+    fn a_thick_tight_bend_stays_filled() {
+        // the inside of the bend is far tighter than the half width
+        let pts = [[0.0, 100.0], [300.0, 40.0], [340.0, 110.0], [220.0, 320.0]];
+        for widths in [[40.0, 90.0, 160.0, 50.0], [60.0, 60.0, 120.0, 120.0]] {
+            for tail in [TAIL_FLAT, TAIL_POINTED] {
+                let p = curve_arrow(&pts, &widths, &ArrowStyle { tail, ..style() });
+                assert_eq!(p.subpaths.len(), 1, "no hole on the inside of the bend: {widths:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn the_path_is_one_clean_outline() {
+        let p = curve_arrow(&[[10.0, 200.0], [150.0, 40.0], [300.0, 160.0]], &[10.0, 20.0, 30.0], &style());
+        assert_eq!(p.subpaths.len(), 1, "the pieces merge into one outline");
+    }
+
+    #[test]
+    fn every_style_builds() {
+        for head in [HEAD_TRIANGLE, HEAD_BARBED, HEAD_OPEN, HEAD_NONE] {
+            for tail in [TAIL_FLAT, TAIL_POINTED, TAIL_ARROW] {
+                for round in [0.0, 50.0, 100.0] {
+                    let s = ArrowStyle { head, tail, tip_round: round, barb_round: round, tail_round: round, ..style() };
+                    let p = curve_arrow(&[[10.0, 200.0], [120.0, 20.0], [260.0, 160.0]], &[10.0, 20.0, 30.0], &s);
+                    assert!(!p.subpaths.is_empty(), "head {head} tail {tail} round {round}");
+                    assert!(p.subpaths.iter().flat_map(|sp| sp.knots.iter()).all(|k| k.anchor.x.is_finite() && k.anchor.y.is_finite()));
+                }
+            }
+        }
+    }
+}
