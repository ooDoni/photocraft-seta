new file mode 100644
index 0000000..162ee20
--- /dev/null
+++ b/crates/vector/tests/curve_arrow_parity.rs
@@ -0,0 +1,47 @@
+//! The curved arrow's outline matches the reference implementation it was ported from (the
+//! Photoshop script), point for point, for every head, start and rounding.
+
+use photocraft_vector::curve_arrow::{Anchor, ArrowStyle, arrow_polygons};
+use serde_json::Value;
+
+fn p(v: &Value) -> [f64; 2] {
+    [v[0].as_f64().unwrap_or(f64::NAN), v[1].as_f64().unwrap_or(f64::NAN)]
+}
+
+#[test]
+fn matches_the_reference_outline() {
+    let text = include_str!("fixtures/curve_arrow_js.json");
+    let fx: Value = serde_json::from_str(text).unwrap_or(Value::Null);
+    let anchors: Vec<Anchor> = fx["anchors"].as_array().into_iter().flatten().map(|a| Anchor { a: p(&a[0]), i: p(&a[1]), o: p(&a[2]) }).collect();
+    let widths: Vec<f64> = fx["widths"].as_array().into_iter().flatten().filter_map(Value::as_f64).collect();
+    let cases = fx["cases"].as_array().cloned().unwrap_or_default();
+    assert_eq!(cases.len(), 36);
+    let mut worst = 0.0_f64;
+    for c in &cases {
+        let r = c["round"].as_f64().unwrap_or(0.0);
+        let style = ArrowStyle {
+            head: c["head"].as_u64().unwrap_or(0) as u8,
+            head_length: fx["headLength"].as_f64().unwrap_or(0.0),
+            head_width: fx["headWidth"].as_f64().unwrap_or(0.0),
+            tip_round: r,
+            barb_round: r,
+            tail: c["tail"].as_u64().unwrap_or(0) as u8,
+            tail_round: r,
+            dash: 0.0,
+            gap: 0.0,
+            dash_round: 0.0,
+        };
+        let got = arrow_polygons(&anchors, &widths, &style);
+        let want = c["polys"].as_array().cloned().unwrap_or_default();
+        assert_eq!(got.len(), want.len(), "polygon count, case {c:?}");
+        for (gp, wp) in got.iter().zip(&want) {
+            let wp = wp.as_array().cloned().unwrap_or_default();
+            assert_eq!(gp.len(), wp.len(), "point count, head {} tail {} round {r}", c["head"], c["tail"]);
+            for (g, w) in gp.iter().zip(&wp) {
+                let w = p(w);
+                worst = worst.max((g[0] - w[0]).abs()).max((g[1] - w[1]).abs());
+            }
+        }
+    }
+    assert!(worst < 1e-6, "largest difference {worst}");
+}
