+        /// Dash length in multiples of the width (0 = solid line).
+        #[serde(default)]
+        dash: f64,
+        /// Gap between dashes in multiples of the width.
+        #[serde(default)]
+        gap: f64,
+        /// Rounding of the dashes' ends (%).
+        #[serde(default)]
+        dash_round: f64,
+        /// Per point, the curve's handles as offsets from the point, `[in x, in y, out x, out y]`;
+        /// `None` (or no entry) = automatic, smooth through the neighbouring points.
+        #[serde(default)]
+        handles: Vec<Option<[f64; 4]>>,
+        /// Opacity (%) at the start and at the tip, blended along the arrow's curve.
+        #[serde(default = "full_percent")]
+        fade_start: f64,
+        #[serde(default = "full_percent")]
+        fade_end: f64,
+        /// Per point, a colour of its own: the arrow is painted along its curve from colour to
+        /// colour (an uncoloured start or tip has the fill's colour, an uncoloured point between
+        /// blends with its neighbours). Empty = the fill as it is.
+        #[serde(default)]
+        colors: Vec<Option<Color>>,
+    },
+}
+
+fn full_percent() -> f64 {
+    100.0
 }
 
