+/// A curved arrow under `a`, or `None` when `a` is not a similarity (it would regenerate unskewed).
+fn transform_curve_arrow(l: LiveShape, a: &Affine) -> Option<LiveShape> {
+    let LiveShape::CurveArrow { points, widths, head, head_length, head_width, tip_round, barb_round, tail, tail_round, dash, gap, dash_round } = l else {
+        return None;
+    };
+    let [m0, m1, m2, m3, tx, ty] = a.m;
+    let k = (m0 * m3 - m1 * m2).abs().sqrt();
+    if !k.is_finite() || k < 1e-9 {
+        return None;
+    }
+    let tol = 1e-9 * k.max(1.0);
+    let rotation = (m0 - m3).abs() <= tol && (m1 + m2).abs() <= tol;
+    let reflection = (m0 + m3).abs() <= tol && (m1 - m2).abs() <= tol;
+    if !(rotation || reflection) {
+        return None;
+    }
+    let points = points.iter().map(|p| [m0 * p[0] + m2 * p[1] + tx, m1 * p[0] + m3 * p[1] + ty]).collect();
+    Some(LiveShape::CurveArrow {
+        points,
+        widths: widths.iter().map(|w| (w * k).clamp(0.1, 1.0e6)).collect(),
+        head,
+        head_length: head_length * k,
+        head_width: head_width * k,
+        tip_round,
+        barb_round,
+        tail,
+        tail_round,
+        dash,
+        gap,
+        dash_round,
+    })
+}
